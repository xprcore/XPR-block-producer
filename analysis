  if(!cleanUrl) return null;

  const attempts=[
    async()=>{
      const response=await fetch(cleanUrl,{cache:'no-store',redirect:'follow'});
      if(!response.ok) throw new Error('HTTP '+response.status);
      const text=await response.text();
      return JSON.parse(text);
    },
    async()=>{
      const proxy='https://api.allorigins.win/get?url='+encodeURIComponent(cleanUrl);
      const response=await fetch(proxy,{cache:'no-store'});
      if(!response.ok) throw new Error('proxy HTTP '+response.status);
      const wrapper=await response.json();
      if(!wrapper || typeof wrapper.contents!=='string') throw new Error('empty proxy contents');
      return JSON.parse(wrapper.contents);
    },
    async()=>{
      const proxy='https://api.allorigins.win/raw?url='+encodeURIComponent(cleanUrl);
      const response=await fetch(proxy,{cache:'no-store'});
      if(!response.ok) throw new Error('raw proxy HTTP '+response.status);
      return await response.json();
    }
  ];

  for(const attempt of attempts){
    try{return await attempt();}catch(error){}
  }
  return null;
}

