function parseExplorerVoteDeltas(html){
  const map=new Map();
  const doc=new DOMParser().parseFromString(html,"text/html");
  const rows=[...doc.querySelectorAll("tr")];
  rows.forEach(row=>{
    const cells=[...row.querySelectorAll("td")];
    if(cells.length<5) return;
    const text=cells.map(c=>c.textContent.trim());
    const accountCandidates=[text[2],text[1],text[0]];
    const account=accountCandidates.map(v=>String(v||"").trim().toLowerCase())
      .find(v=>/^[a-z1-5.]{1,12}$/.test(v))||"";
    if(!account) return;
    const voteCell=cells.find(c=>/[0-9][0-9,]*\s*[+−-]\s*[0-9][0-9,]*/.test(c.textContent.replace(/\s+/g," "))) || cells[7] || cells[cells.length-1];
    const raw=voteCell.textContent.replace(/\s+/g," ").trim();
    const m=raw.match(/([+−-])\s*([0-9][0-9,]*)/);
    if(!m) return;
    const value=Number(m[2].replace(/,/g,""));
    if(!Number.isFinite(value)) return;
    map.set(account,m[1]==="-"||m[1]==="−"?-value:value);
  });
  return map;
}

async function loadProducerVotes24hFromExplorer(){
  // Explorer is the reference for the displayed 24h delta.  A local HTML file
  // cannot reliably call the Explorer SPA directly because of CORS, so try
  // several no-cache CORS readers.  We reject stale snapshots by comparing the
  // Explorer Total Votes with the current chain Total Votes before accepting
  // the 24h deltas.
  const cb=Date.now().toString()+Math.random().toString(36).slice(2);
  const target="https://explorer.xprnetwork.org/vote?live="+cb;
  const targets=[
    target,
    "https://r.jina.ai/https://explorer.xprnetwork.org/vote?live="+cb,
    "https://r.jina.ai/http://explorer.xprnetwork.org/vote?live="+cb,
    "https://api.allorigins.win/raw?url="+encodeURIComponent(target),
    "https://corsproxy.io/?url="+encodeURIComponent(target),
    "https://api.codetabs.com/v1/proxy?quest="+encodeURIComponent(target)
  ];

  // Current on-chain votes are used only as a freshness check, never as the
  // source of the displayed 24h delta.
  const currentByAccount=new Map();
  try{
    const currentRows=await rpcRequest("/v1/chain/get_table_rows",{
      json:true,code:"eosio",scope:"eosio",table:"producers",limit:1000
    });
    for(const p of (currentRows?.rows||[])){
      const a=String(p?.owner||p?.producer||"").toLowerCase();
      if(a) currentByAccount.set(a,rawVotesToExplorerVotes(p?.total_votes??p?.votes??0));
    }
  }catch(e){ console.warn("Explorer freshness check RPC failed",e); }

  function parseText(text){
    const found=new Map();
    const rankMovement=new Map();
    const currentSeen=new Map();
    if(!text) return {found,rankMovement,currentSeen};
    const lines=text.split(/\r?\n/).map(x=>x.replace(/\u00a0/g," ").trim()).filter(Boolean);

    // Parse real Explorer HTML rows first. This prevents flattened-text
    // readers from accidentally assigning a neighbouring producer's 24h
    // delta, which was most visible for danemarkbp/luminaryvisn.
    try{
      const doc=new DOMParser().parseFromString(text,"text/html");
      for(const row of [...doc.querySelectorAll("tr")]){
        const cells=[...row.querySelectorAll("th,td")].map(c=>c.textContent.replace(/\s+/g," ").trim());
        if(cells.length<8) continue;
        const account=String(cells[2]||"").toLowerCase();
        if(!/^[a-z1-5.]{1,12}$/.test(account)) continue;
        const rankText=String(cells[1]||"");
        const rankMatch=rankText.match(/[↟↡]\s*([0-9]+)/);
        if(rankMatch) rankMovement.set(account,(rankText.includes("↟")?1:-1)*Number(rankMatch[1]));
        const voteText=String(cells[7]||"");
        const dm=voteText.match(/([+−-])\s*([0-9][0-9,]*)/);
        const tm=voteText.match(/([0-9][0-9,]*)/);
        if(dm && tm){
          const total=Number(tm[1].replace(/,/g,""));
          const delta=Number(dm[2].replace(/,/g,""));
          if(Number.isFinite(total)&&Number.isFinite(delta)){
            currentSeen.set(account,total);
            found.set(account,(dm[1]==="-"||dm[1]==="−")?-delta:delta);
          }
        }
      }
    }catch(e){}

    // Markdown/table form used by text readers.
    for(const line of lines){
      if(!line.includes("|")) continue;
      const cells=line.split("|").map(x=>x.trim());
      if(cells.length<8) continue;
      const rankText=String(cells[1]||"").replace(/\s+/g," ");
      const account=String(cells[2]||"").toLowerCase();
      if(!/^[a-z1-5.]{1,12}$/.test(account)) continue;

      // Explorer's rank-change marker is part of the Rank cell itself.
      // Read it directly instead of deriving movement from vote deltas.
      const rankMatch=rankText.match(/[↟↡]\s*([0-9]+)/);
      if(rankMatch){
        const direction=rankText.includes("↟") ? 1 : -1;
        rankMovement.set(account,direction*Number(rankMatch[1]));
      }

      const voteText=String(cells[7]||"").replace(/\s+/g," ");
      const totalMatch=voteText.match(/([0-9][0-9,]*)/);
      const deltaMatch=voteText.match(/([+−-])\s*([0-9][0-9,]*)/);
      if(!totalMatch||!deltaMatch) continue;
      const total=Number(totalMatch[1].replace(/,/g,""));
      const delta=Number(deltaMatch[2].replace(/,/g,""));
      if(!Number.isFinite(total)||!Number.isFinite(delta)) continue;
      currentSeen.set(account,total);
      found.set(account,(deltaMatch[1]==="-"||deltaMatch[1]==="−")?-delta:delta);
    }

    // Flattened text fallback: locate a producer account and the Total Votes
    // value followed by its signed 24h delta.
    for(const account of currentByAccount.keys()){
      if(!found.has(account)){
        const re=new RegExp("\\b"+account.replace(/\./g,"\\.")+"\\b[^\\n]{0,300}\\b([0-9][0-9,]*)\\s*([+−-])\\s*([0-9][0-9,]*)\\b","i");
        const m=text.match(re);
        if(m){
          const total=Number(m[1].replace(/,/g,""));
          const delta=Number(m[3].replace(/,/g,""));
          if(Number.isFinite(total)&&Number.isFinite(delta)){
            currentSeen.set(account,total);
            found.set(account,(m[2]==="-"||m[2]==="−")?-delta:delta);
          }
        }
      }

      // Explorer rank movement in flattened text appears immediately before
      // the producer name, e.g. "15 ↟1 protonmadrid".
      if(!rankMovement.has(account)){
        const escaped=account.replace(/\./g,"\.");
        const rankRe=new RegExp("\\b[0-9]{1,3}\\s*(?:\\^\\{\\s*)?([↟↡])\\s*([0-9]+)(?:\\s*\\}\\s*)?[^\\n]{0,80}\\b"+escaped+"\\b","i");
        const rm=text.match(rankRe);
        if(rm){
          rankMovement.set(account,(rm[1]==="↟"?1:-1)*Number(rm[2]));
        }
      }
    }
    return {found,rankMovement,currentSeen};
  }

  for(const url of targets){
    try{
      const r=await fetch(url,{cache:"no-store",headers:{"Cache-Control":"no-cache","Pragma":"no-cache"}});
      if(!r.ok) continue;
      const text=await r.text();
      if(text.length<1000) continue;
      const parsed=parseText(text);
      // The Explorer is the reference source for the signed 24h delta shown
      // next to Total Votes. Do not reject it by comparing its rounded/display
      // value with the raw chain producer vote field: those values use different
      // representations and that check can incorrectly discard a valid snapshot.
      if(parsed.found.size<1) continue;

      // Merge fresh Explorer values into the existing map so a transient
      // incomplete response never makes the already displayed +/- value vanish.
      for(const [account,delta] of parsed.found) producerVotes24hMap.set(account,delta);
      producerVotes24hLoaded=true;

      // Rank movement is taken directly from Explorer's Rank column.
      // Do not infer it from vote deltas: the two concepts are not equivalent.
      if(parsed.rankMovement && parsed.rankMovement.size){
        producerRankMovement=new Map(parsed.rankMovement);
      }

      console.info(
        "Fresh Explorer data loaded",
        parsed.found.size,
        "24h deltas and",
        parsed.rankMovement.size,
        "rank movements via",
        url
      );
      return true;
    }catch(e){
      console.warn("Explorer reader failed",e);
    }
  }
  return false;
}

