let transactions24hCache={ts:0,head:0,value:null};

function extractTransactions24h(data){
  if(data==null)return null;
  const seen=new Set();
  const walk=(obj,depth=0)=>{
    if(obj==null||depth>5)return null;
    if(typeof obj!=='object')return null;
    if(seen.has(obj))return null;
    seen.add(obj);
    const keys=['transactions','transaction_count','trx_count','trxcount','total_transactions','total_trx','tx_count','txcount'];
    for(const key of keys){
      if(Object.prototype.hasOwnProperty.call(obj,key)){
        const value=obj[key];
        if(typeof value==='number'&&Number.isFinite(value)&&value>=0)return Math.round(value);
        if(typeof value==='string'&&value.trim()!==''&&Number.isFinite(Number(value))&&Number(value)>=0)return Math.round(Number(value));
        if(value&&typeof value==='object'){
          const nested=walk(value,depth+1);
          if(nested!==null)return nested;
        }
      }
    }
    for(const value of Object.values(obj)){
      if(value&&typeof value==='object'){
        const nested=walk(value,depth+1);
        if(nested!==null)return nested;
      }
    }
    return null;
  };
  return walk(data);
}

async function loadTransactions24h(headBlock){
  const now=Date.now();
  if(transactions24hCache.value!==null && now-transactions24hCache.ts<60000 && Math.abs(Number(headBlock||0)-transactions24hCache.head)<5000)return transactions24hCache.value;

  // Prefer Hyperion's documented aggregate transaction statistics. This is
  // indexed chain history, not a TPS-based estimate.
  const headDate=parseBlockTimestamp(window.__lastChainHeadTime);
  const endDate=headDate!==null?new Date(headDate).toISOString():new Date(now).toISOString();
  const encodedEnd=encodeURIComponent(endDate);
  const endpoints=[
    `/v2/stats/get_action_usage?period=24h&end_date=${encodedEnd}`,
    `/v2/stats/get_trx_count?from=${Math.max(1,Number(headBlock||1)-200000)}&to=${Number(headBlock||1)}`
  ];

  for(const endpoint of endpoints){
    try{
      const data=await hyperionRequest(endpoint);
      const value=extractTransactions24h(data);
      if(value!==null){
        transactions24hCache={ts:now,head:Number(headBlock)||0,value};
        return value;
      }
    }catch(e){
      console.warn('Transactions / 24h endpoint unavailable',endpoint,e);
    }
  }
  return null;
}

