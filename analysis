function transactionStatus(tx){
  const status=String(tx?.status||tx?.trx?.status||"").toLowerCase();
  if(status==="executed"||status==="included"||status==="success"||status==="executed_trx")return "success";
  if(status==="soft_fail"||status==="hard_fail"||status==="expired"||status==="failed"||status==="failure")return "failure";
  return null;
}

function calculateRecentBlockAnalytics(){
  const blocks=[...latestBlocks].filter(Boolean).sort((a,b)=>Number(b.block_num)-Number(a.block_num));
  if(!blocks.length)return null;
  const intervals=[];
  const blockTimes=[];
  const producers=[];
  let txCount=0;
  let txSuccess=0;
  let txFailure=0;
  let netWords=0;
  for(const block of blocks){
    producers.push(block.producer);
    const txs=getBlockTransactions(block);
    txCount+=txs.length;
    for(const tx of txs){
      const status=transactionStatus(tx);
      if(status==="success")txSuccess++;
      if(status==="failure")txFailure++;
      netWords+=Number(tx?.net_usage_words||tx?.trx?.net_usage_words||0)||0;
    }
  }
  for(let i=0;i<blocks.length-1;i++){
    const newer=blocks[i], older=blocks[i+1];
    const numberDiff=Number(newer.block_num)-Number(older.block_num);
    const newerTime=parseBlockTimestamp(newer.timestamp), olderTime=parseBlockTimestamp(older.timestamp);
    if(newerTime!==null&&olderTime!==null&&numberDiff>0){
      const seconds=(newerTime-olderTime)/1000/numberDiff;
      if(seconds>=0&&seconds<300){intervals.push(seconds);blockTimes.push({ts:newerTime,value:seconds,block:Number(newer.block_num)});}
    }
  }
  const elapsed=intervals.length?intervals.reduce((a,b)=>a+b,0):null;
  const newestTime=blocks.length?parseBlockTimestamp(blocks[0].timestamp):null;
  const oldestTime=blocks.length?parseBlockTimestamp(blocks[blocks.length-1].timestamp):null;
  const sampleElapsedSeconds=newestTime!==null&&oldestTime!==null&&newestTime>=oldestTime?(newestTime-oldestTime)/1000:null;
  const avgBlockTime=intervals.length?elapsed/intervals.length:null;
  const tps=sampleElapsedSeconds&&sampleElapsedSeconds>0?txCount/sampleElapsedSeconds:null;
  const knownTx=txSuccess+txFailure;
  const successRate=knownTx?(txSuccess/knownTx)*100:null;
  const uniqueProducers=[...new Set(producers.filter(Boolean))];
  const latest=blocks[0];
  const latestTxs=getBlockTransactions(latest);
  return {
    blocks, checked:blocks.length, uniqueProducers, avgBlockTime, currentBlockTime:blockTimes[0]?.value??null,
    currentTPS:latestTxs.length&&blockTimes.length&&blockTimes[0].value>0?latestTxs.length/blockTimes[0].value:null,
    tps, txCount, latestTxCount:latestTxs.length, successRate, txSuccess, txFailure,
    avgTxPerBlock:blocks.length?txCount/blocks.length:null,
    sampleElapsedSeconds, netWords, blockTimes, producers, latestBlock:latest
  };
}

function formatBytes(bytes){
  const n=Number(bytes);
  if(!Number.isFinite(n)||n<0)return "—";
  if(n<1024)return Math.round(n)+" B";
  if(n<1024*1024)return (n/1024).toFixed(2)+" KB";
  return (n/1024/1024).toFixed(2)+" MB";
}

