/* =========================================================
HELPERS
========================================================= */

function escapeHTML(value){

return String(value??"")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}

function formatNumber(value){

const number=Number(value);

if(!Number.isFinite(number)){
return String(value??"—");
}

return new Intl.NumberFormat("en-US",{
maximumFractionDigits:0
}).format(number);

}

function formatPercent(value){

if(!Number.isFinite(value))return "—";

return value.toFixed(1)+"%";

}

function parseBlockTimestamp(timestamp){

if(!timestamp)return null;

const time=Date.parse(
String(timestamp).endsWith("Z")
?String(timestamp)
:String(timestamp)+"Z"
);

return Number.isFinite(time)?time:null;

}

/* =========================================================
XPR VOTE WEIGHT
========================================================= */

function voteWeightAtMs(ms){
  const epoch=Date.UTC(2000,0,1,0,0,0,0);
  const t=Number(ms);
  if(!Number.isFinite(t)) return 0;
  const secondsPerWeek=86400*7;
  const completeWeeks=Math.floor((t-epoch)/1000/secondsPerWeek);
  return completeWeeks/52;
}

function voteWeightToday(){
  return voteWeightAtMs(Date.now());
}

function rawVotesToExplorerVotes(value, atMs){
  if(value===undefined||value===null||value==="")return 0;
  const raw=Number(String(value).replace(/,/g,""));
  if(!Number.isFinite(raw))return 0;
  const precision=10000;
  const exponent=Number.isFinite(Number(atMs)) ? voteWeightAtMs(Number(atMs)) : voteWeightToday();
  const weight=Math.pow(2,exponent);
  return raw/precision/weight;
}

function formatExplorerVotes(value){

const votes=rawVotesToExplorerVotes(value);

if(!Number.isFinite(votes))return "—";

return new Intl.NumberFormat("en-US",{
maximumFractionDigits:0,
minimumFractionDigits:0
}).format(Math.round(votes));

}

