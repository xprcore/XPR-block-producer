const promise=getCurrentAccountProducerVotesRaw(account,voterRow).then(value=>{modalDataCache.set(cacheKey,{ts:Date.now(),value});return value;}).finally(()=>modalDataInFlight.delete(cacheKey));
modalDataInFlight.set(cacheKey,promise);
