  }catch(e){}
}

function extractLogoCandidatesFromBP(bp,bpUrl,account){
  const out=[];
  if(!bp || typeof bp!=='object') return out;
  const branding=bp?.org?.branding||bp?.organization?.branding||bp?.branding||{};
  const values=[
    branding.logo_256,branding.logo_1024,branding.logo_svg,
    branding.logo,branding.icon,
    bp.logo_256,bp.logo_1024,bp.logo_svg,bp.logo,bp.icon
  ];
  for(const value of values){
    if(typeof value!=='string' || !value.trim()) continue;
    try{
      const absolute=new URL(value.trim(),bpUrl).href;
      if(!out.includes(absolute)) out.push(absolute);
    }catch(e){}
  }
  return out;
}

function extractLogoCandidatesFromHTML(html,pageUrl){
  if(!html) return [];
  const out=[];
  const patterns=[
    /<meta[^>]+property=["']og:image["'][^>]+content=["']([^"']+)["']/ig,
    /<meta[^>]+name=["']twitter:image["'][^>]+content=["']([^"']+)["']/ig,
    /<link[^>]+rel=["'][^"']*(?:icon|apple-touch-icon)[^"']*["'][^>]+href=["']([^"']+)["']/ig,
    /<img[^>]+(?:alt|title)=["'][^"']*(?:logo|brand)[^"']*["'][^>]+src=["']([^"']+)["']/ig
  ];
  for(const re of patterns){
    let m;
    while((m=re.exec(html))!==null){
      try{
        const u=new URL(m[1],pageUrl).href;
        if(!out.includes(u)) out.push(u);
      }catch(e){}
    }
  }
  return out;
}

async function loadProducerLogosFromPublicBPRegistry(){

  producerLogoMap=new Map();
  producerBPMap=new Map();

  const producers=producerData.filter(p=>Boolean(p.is_active));
  const concurrency=8;
  let cursor=0;

  async function worker(){
    while(cursor<producers.length){
      const index=cursor++;
      const producer=producers[index];
      const account=String(producer.owner||producer.producer||'').trim().toLowerCase();
      if(!account) continue;

      const registered=normalizeURL(producer.url);
      const origin=normalizeProducerOrigin(registered);
      if(!origin) continue;

      const logoCandidates=[];

      // 1) Standard Antelope chains.json -> chain-specific bp.json.
      try{
        const chains=await fetchJsonDirectOrProxy(origin+'/chains.json');
        const chainBP=extractBPJsonURL(chains,origin);
        if(chainBP) logoCandidates.push(chainBP);
      }catch(e){}

      // 2) Standard /bp.json and a few widely used variants.
      logoCandidates.push(
        origin+'/bp.json',
        origin+'/.well-known/bp.json'
      );

      let bp=null;
      let usedBPUrl='';

      for(const bpUrl of logoCandidates){
        try{
          const candidate=await fetchJsonDirectOrProxy(bpUrl);
          if(!candidate || typeof candidate!=='object') continue;
          const bpAccount=String(
            candidate.producer_account_name||candidate.producerAccountName||
            candidate.owner||candidate.producer||''
          ).trim().toLowerCase();
          if(bpAccount && bpAccount!==account) continue;
          bp=candidate;
          usedBPUrl=bpUrl;
          break;
        }catch(e){}
      }

      if(bp){
        const logos=extractLogoCandidatesFromBP(bp,usedBPUrl,account);
        for(const logo of logos) if(!logoCandidates.includes(logo)) logoCandidates.push(logo);
        producerBPMap.set(account,bp);
      }

      // 3) Last-resort official-site metadata. This catches producers whose
      // bp.json is temporarily missing, malformed, or uses a nonstandard path.
      if(logoCandidates.length<4){
        try{
          const html=await fetchTextDirectOrProxy(origin+'/');
          const siteLogos=extractLogoCandidatesFromHTML(html,origin+'/');
          for(const logo of siteLogos) if(!logoCandidates.includes(logo)) logoCandidates.push(logo);
        }catch(e){}
      }

      // 4) Extremely reliable browser-side fallback: favicons for the
      // producer domain. These do NOT require CORS because the browser loads
      // them as normal <img> resources. This guarantees that a producer with
      // a broken/missing bp.json can still have a real site icon instead of
      // the first-letter avatar.
      try{
        const host=new URL(origin).hostname;
        if(host){
          const faviconCandidates=[
            `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=128`,
            `https://icons.duckduckgo.com/ip3/${encodeURIComponent(host)}.ico`,
            `${origin}/favicon.ico`
          ];
          for(const icon of faviconCandidates){
            if(!logoCandidates.includes(icon)) logoCandidates.push(icon);
          }
        }
      }catch(e){}

      // IMPORTANT: do not put an untested URL into the DOM. Some producer
      // sites return a broken image, redirect, HTML, or a blocked resource.
      // That used to make the logo appear briefly and then disappear.
      // Test the actual image resource first and store ONLY a URL that really
      // loads in the browser.
      const images=[...new Set(logoCandidates.filter(u=>/^https?:/i.test(u)))].slice(0,12);

      const working=await findFirstWorkingImage(images);
      if(working) producerLogoMap.set(account,[working]);
    }
  }

  await Promise.all(
    Array.from({length:Math.min(concurrency,producers.length)},()=>worker())
  );
}

function findFirstWorkingImage(urls){
  if(!Array.isArray(urls)||!urls.length) return Promise.resolve('');
  return new Promise(resolve=>{
    let pending=urls.length;
    let done=false;
    const finish=url=>{
      if(done) return;
      done=true;
      resolve(url||'');
    };
    urls.forEach(url=>{
      const img=new Image();
      let settled=false;
      const timer=setTimeout(()=>{
        if(settled) return;
        settled=true;
        pending--;
        if(pending<=0) finish('');
      },3500);
      img.onload=()=>{
        if(settled) return;
        settled=true;
        clearTimeout(timer);
        finish(url);
      };
      img.onerror=()=>{
        if(settled) return;
        settled=true;
        clearTimeout(timer);
        pending--;
        if(pending<=0) finish('');
      };
      img.src=url;
    });
  });
}

