async function loadTelegramMissedRounds(range){
  const now=Date.now();
  const cached=telegramReliabilityCache.get(range);
  if(cached&&now-cached.ts<TELEGRAM_RELIABILITY_CACHE_MS)return cached;
  if(telegramReliabilityInFlight.has(range))return telegramReliabilityInFlight.get(range);

  const promise=(async()=>{
    const cutoffMs=Date.now()-timeframeMs(range);
    const url='../data/missed-blocks.json?ts='+Date.now();
    let payload=null;
    try{
      const response=await fetch(url,{cache:'no-store'});
      if(!response.ok)throw new Error('missed-blocks.json HTTP '+response.status);
      payload=await response.json();
    }catch(error){
      console.warn('Central missed-block history unavailable:',error);
    }

    const allEvents=Array.isArray(payload?.events)?payload.events:[];
    const events=allEvents.filter(e=>Number(e.ts)>=cutoffMs);
    const byProducer={};
    for(const event of events){
      const producer=String(event.producer||'').trim().toLowerCase();
      if(!producer)continue;
      if(!byProducer[producer])byProducer[producer]=[];
      byProducer[producer].push(event);
    }
    const coverageOk=Boolean(payload?.coverageOk) && Number(payload?.oldestTs||Infinity)<=cutoffMs;
    const result={ts:Date.now(),events,byProducer,coverageOk,pages:Number(payload?.pages||0),source:payload?.source||'github-actions'};
    telegramReliabilityCache.set(range,result);
    return result;
  })();
  telegramReliabilityInFlight.set(range,promise);
  try{return await promise;}finally{telegramReliabilityInFlight.delete(range);}
}

async function loadExactBlockProduction(range){
  const now=Date.now();
  const cached=blockProductionCache.get(range);
  if(cached&&now-cached.ts<BLOCK_PRODUCTION_CACHE_MS)return cached.rows;
  if(blockProductionInFlight.has(range))return blockProductionInFlight.get(range);

  const names=getActiveProducerNames();
  if(!names.length)return [];
  const promise=(async()=>{
    const after=new Date(Date.now()-timeframeMs(range)).toISOString();
    const before=new Date().toISOString();
    const telegram=await loadTelegramMissedRounds(range);
    const rows=[];

    await Promise.all(names.map(async name=>{
      let count=0,productionError=false;
      try{
        const params=new URLSearchParams({account:'eosio',filter:'eosio:onblock',producer:name,after,before,limit:'1',track:'true',noBinary:'true'});
        const responses=await hyperionAllEndpoints(`/v2/history/get_actions?${params.toString()}`);
        const counts=responses.map(({data})=>Number(data?.total?.value ?? data?.total ?? data?.count ?? 0)).filter(Number.isFinite);
        if(counts.length)count=Math.max(...counts.map(n=>Math.max(0,Math.round(n))));
        else productionError=true;
      }catch(error){
        productionError=true;
        console.warn('Exact block production lookup failed for',name,error);
      }

      // The reliability channel is the authoritative source for missed rounds.
      // One missed round is six producer slots on XPR. We only calculate
      // Expected when the Telegram history was successfully walked back far
      // enough to cover the complete selected timeframe; otherwise show an em
      // dash instead of inventing a value.
      const missedRounds=telegram.byProducer?.[name]?.length||0;
      const missed=missedRounds===null?null:missedRounds*6;
      const scheduled=missed===null?null:count+missed;
      rows.push({name,count,missed,missedRounds,scheduled,productionError,missedError:missed===null});
    }));
    rows.sort((a,b)=>b.count-a.count||a.name.localeCompare(b.name));
    blockProductionCache.set(range,{ts:Date.now(),rows});
    return rows;
  })();
  blockProductionInFlight.set(range,promise);
  try{return await promise;}finally{blockProductionInFlight.delete(range);}
}


