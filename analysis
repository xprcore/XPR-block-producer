async function getAccountVoterRow(account){
  const tableNames=[
    "votersxpr",
    "voters"
  ];

  for(const tableName of tableNames){
    try{
      const result=await rpcRequest(
        "/v1/chain/get_table_rows",
        {
          json:true,
          code:"eosio",
          scope:"eosio",
          table:tableName,
          lower_bound:account,
          upper_bound:account,
          limit:10
        }
      );

      if(result.rows&&result.rows.length){
        const exact=result.rows.find(row=>
          getVoterAccount(row)===account
        );

        return exact||result.rows[0];
      }
    }catch(error){
      console.warn(
        "Account voter lookup failed:",
        tableName,
        error
      );
    }
  }

  return null;
}

function getAccountVoteList(row){
  if(!row)return [];

  const lists=[
    row.producers,
    row.producer_votes,
    row.voted_producers,
    row.votes_for
  ];

  const result=[];

  for(const list of lists){
    if(!Array.isArray(list))continue;

    for(const item of list){
      let producer="";

      if(typeof item==="string"){
        producer=item;
      }else if(item&&typeof item==="object"){
        producer=
          item.producer||
          item.owner||
          item.name||
          item.account||
          "";
      }

      producer=String(producer||"").trim();

      if(producer&&!result.includes(producer)){
        result.push(producer);
      }
    }
  }

  return result;
}

/*
  Long staking has changed over the lifetime of XPR Network.
  The function tries the common legacy table layouts and safely
  returns 0 when the account has no readable long-stake position.
*/
async function getAccountLongStake(account){
const cacheKey="long-stake:"+String(account||"").toLowerCase();
const cached=modalDataCache.get(cacheKey);
if(cached&&Date.now()-cached.ts<MODAL_CACHE_MS)return cached.value;
const existing=modalDataInFlight.get(cacheKey);
if(existing)return existing;
const promise=getAccountLongStakeRaw(account).then(value=>{modalDataCache.set(cacheKey,{ts:Date.now(),value});return value;}).finally(()=>modalDataInFlight.delete(cacheKey));
modalDataInFlight.set(cacheKey,promise);
return promise;
}

async function getAccountLongStakeRaw(account){
  try{
    const wanted=String(account||"").toLowerCase();

    // The long-staking table is ordered by account owner. Query the account
    // directly instead of scanning thousands of rows page-by-page. XPR's
    // table API supports lower/upper bounds for exact account lookups.
    const direct=await rpcRequest("/v1/chain/get_table_rows",{
      json:true,
      code:"longstaking",
      scope:"longstaking",
      table:"stakes",
      lower_bound:wanted,
      upper_bound:wanted,
      limit:100
    });

    const rows=Array.isArray(direct?.rows)?direct.rows:[];
    let total=0;
    for(const row of rows){
      const owner=String(row.account||row.owner||row.staker||row.user||row.from||"").toLowerCase();
      if(owner!==wanted)continue;
      const value=row.staked!==undefined?row.staked:row.quantity;
      const n=accountAssetNumber(value);
      if(n>0)total+=n;
    }
    return total;
  }catch(error){
    console.warn("Long stake direct lookup failed:",error);
    return 0;
  }
}

async function getCurrentAccountProducerVotes(account,voterRow){
