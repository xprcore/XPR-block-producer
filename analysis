/* Mobile layout improvements */
@media (max-width: 900px){
  .container, .wrap, main{max-width:100% !important; width:100% !important;}
  body{overflow-x:hidden;}
  .grid, .cards, .dashboard-grid, .analytics-grid{grid-template-columns:1fr !important;}
  .two-col, .three-col{grid-template-columns:1fr !important;}
  .card{min-width:0 !important; width:100%;}
  table{display:block; width:100%; overflow-x:auto; -webkit-overflow-scrolling:touch;}
  .modal, .modal-content, .dialog{width:calc(100vw - 24px) !important; max-width:none !important; margin:12px auto !important;}
  .modal-body{max-height:calc(100vh - 140px); overflow:auto;}
  input, select, button{max-width:100%;}
}
@media (max-width: 600px){
  body{font-size:14px;}
  .container, .wrap, main{padding-left:10px !important; padding-right:10px !important;}
  h1{font-size:22px !important;}
  h2{font-size:18px !important;}
  h3{font-size:16px !important;}
  .card, section, .panel{padding:12px !important; border-radius:12px !important;}
  .toolbar, .controls, .actions{flex-wrap:wrap !important; gap:8px !important;}
  .toolbar > *, .controls > *, .actions > *{flex:1 1 140px; min-width:0;}
  .stat-grid, .stats-grid{grid-template-columns:1fr 1fr !important;}
  .modal, .modal-content, .dialog{width:calc(100vw - 16px) !important; margin:8px auto !important;}
}
@media (max-width: 420px){
  .stat-grid, .stats-grid{grid-template-columns:1fr !important;}
  .toolbar > *, .controls > *, .actions > *{flex-basis:100%;}
}
