/*
  The eosio.votersxpr RPC row on many public XPR RPC nodes contains the
  staked amount but does NOT expose the selected producer array. The
  authoritative current vote is the latest eosio::voteproducer action.
  Hyperion indexes actions by authorization actor, so use that as the
  fallback instead of pretending the RPC row contains voting records.
*/
async function getLatestProducerVoteCached(account){
const cacheKey="latest-vote:"+String(account||"").toLowerCase();
const cached=modalDataCache.get(cacheKey);
if(cached&&Date.now()-cached.ts<MODAL_CACHE_MS)return cached.value;
const existing=modalDataInFlight.get(cacheKey);
if(existing)return existing;
const promise=getLatestProducerVote(account)
.then(value=>{modalDataCache.set(cacheKey,{ts:Date.now(),value});return value;})
.finally(()=>modalDataInFlight.delete(cacheKey));
modalDataInFlight.set(cacheKey,promise);
return promise;
}

async function getLatestProducerVote(account){
  /*
    IMPORTANT: Hyperion's get_actions endpoint is indexed by the notified
    account. A voteproducer action is notified to `eosio`, not to the voter,
    so querying `account=<voter>` can miss the record.

    First use Hyperion's voter-specific get_links index. It is much more
    reliable for this job because it can return the account's voteproducer
    links directly; then fetch the linked transaction and read the exact
    current voteproducer action. Only if that path fails do we fall back to
    scanning the eosio voteproducer history.
  */
  const wanted=String(account||"").trim().toLowerCase();
  if(!wanted)return null;

  // 1) Preferred path: account-specific links -> transaction -> voteproducer.
  try{
    const linksResult=await hyperionRequest(`/v2/state/get_links?account=${encodeURIComponent(account)}&limit=1000`);
    const links=Array.isArray(linksResult?.links)?linksResult.links:
      (Array.isArray(linksResult?.results)?linksResult.results:[]);

    const voteLinks=links.filter(link=>
      String(link?.action||link?.act_name||link?.name||"").toLowerCase()==="voteproducer"
    );

    for(const link of voteLinks){
      const trxId=String(link?.trx_id||link?.transaction_id||link?.txid||"").trim();
      if(!trxId)continue;

      try{
        const tx=await hyperionRequest(`/v2/history/get_transaction?id=${encodeURIComponent(trxId)}`);
        const actions=Array.isArray(tx?.actions)?tx.actions:
          (Array.isArray(tx?.trx?.actions)?tx.trx.actions:[]);

        for(const action of actions){
          const data=action?.act?.data||action?.data||{};
          const name=String(action?.act?.name||action?.name||"").toLowerCase();
          const contract=String(action?.act?.account||action?.account||"").toLowerCase();
          const auth=Array.isArray(action?.act?.authorization)?action.act.authorization:
            (Array.isArray(action?.authorization)?action.authorization:[]);
          const voter=String(
            data.voter||
            auth.find(a=>String(a?.actor||a?.account||"").trim().toLowerCase()===wanted)?.actor||
            ""
          ).trim().toLowerCase();

          if(name==="voteproducer" && (!contract||contract==="eosio") && voter===wanted){
            return action;
          }
        }
      }catch(error){
        console.warn("Voteproducer transaction lookup failed:",trxId,error);
      }
    }
  }catch(error){
    console.warn("Account-specific Hyperion vote links lookup failed:",error);
  }

  const queryBuilders=[
    (skip)=>`/v2/history/get_actions?account=eosio&filter=eosio:voteproducer&limit=100&skip=${skip}&sort=desc`,
    (skip)=>`/v2/history/get_actions?account=eosio&act_account=eosio&act_name=voteproducer&limit=100&skip=${skip}&sort=desc`,
    (skip)=>`/v2/history/get_actions?account=eosio&act_name=voteproducer&limit=100&skip=${skip}&sort=desc`
  ];

  for(const buildQuery of queryBuilders){
    try{
      for(let skip=0;skip<=3000;skip+=100){
        const result=await hyperionRequest(buildQuery(skip));
        const actions=Array.isArray(result?.actions)?result.actions:
          (Array.isArray(result?.data)?result.data:
          (Array.isArray(result?.results)?result.results:[]));

        if(!actions.length)break;

        for(const action of actions){
          const data=action?.act?.data||action?.data||action?.action_trace?.act?.data||action?.action?.data||{};
          const auth=Array.isArray(action?.act?.authorization)?action.act.authorization:
            (Array.isArray(action?.authorization)?action.authorization:[]);
          const voter=String(
            data.voter||
            data.from||
            auth.find(a=>String(a?.actor||a?.account||"").trim().toLowerCase()===wanted)?.actor||
            ""
          ).trim().toLowerCase();

          if(voter===wanted){
            return action;
          }
        }

        if(actions.length<100)break;
      }
    }catch(error){
      console.warn("Latest voteproducer lookup failed:",error);
    }
  }

  return null;
}

function getVoteProducerList(action){
  if(!action)return [];
  const data=
    action?.act?.data||
    action?.data||
    action?.action_trace?.act?.data||
    action?.action?.data||{};

  const producers=Array.isArray(data.producers)?data.producers:[];
