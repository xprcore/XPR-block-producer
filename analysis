/*
XPR uses 4 decimal places.
Example:
1.0000 XPR = 10000 raw units.
*/

function stakingAmount(value){

if(
value===undefined||
value===null||
value===""
){
return 0;
}

/*
  XPR staking values can arrive either as a normal asset string
  (for example "23002116.9131 XPR") or as a raw integer in
  1/10,000 XPR units. Never divide an already-formatted asset
  string by 10,000.
*/
const text=String(value).trim();

if(/[A-Za-z]/.test(text)){
  const asset=accountAssetNumber(text);
  return Number.isFinite(asset)?asset:0;
}

const raw=Number(text.replace(/,/g,""));

if(!Number.isFinite(raw))return 0;

return Math.abs(raw)>=10000?raw/10000:raw;

}

function formatStakingXPR(value){

const number=Number(value);

if(!Number.isFinite(number)){
return "—";
}

return new Intl.NumberFormat("en-US",{
minimumFractionDigits:0,
maximumFractionDigits:4
}).format(number)+" XPR";

}

