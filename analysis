const LONG_STAKING_CONTRACT="longstaking";
const STAKING_ANALYTICS_WINDOWS={
  "24h":24*60*60*1000,
  "7d":7*24*60*60*1000,
  "30d":30*24*60*60*1000
};

let shortStakeHistory=[];
let longStakeHistory=[];
let stakingHistoryLoading=false;
let lastStakingHistoryRun=0;

/*
  Hyperion action helpers.
  Some Hyperion responses expose fields directly while others wrap them
  inside action_trace/action_trace.act. Keep the staking analytics parser
  compatible with both forms.
*/
function getHistoryActionName(action){
  return String(
    action?.act?.name||
    action?.action_trace?.act?.name||
    action?.action?.name||
    action?.action?.act?.name||
    action?.name||
    ""
  ).toLowerCase();
}

function getHistoryActionAccount(action){
  return String(
    action?.act?.account||
    action?.action_trace?.act?.account||
    action?.action?.account||
    action?.action?.act?.account||
    action?.account||
    ""
  ).toLowerCase();
}

function getHistoryData(action){
  return (
    action?.act?.data||
    action?.action_trace?.act?.data||
    action?.action?.data||
    action?.action?.act?.data||
    action?.data||
    {}
  );
}

function getHistoryTimestamp(action){
  const value=
    action?.["@timestamp"]||
    action?.timestamp||
    action?.block_time||
    action?.created_at||
    action?.action_trace?.block_time||
    action?.action_trace?.block_timestamp||
    action?.action?.block_time||
    null;

  const time=Date.parse(value);
  return Number.isFinite(time)?time:NaN;
}

function getHistoryTransactionId(action){
  return String(
    action?.trx_id||
    action?.transaction_id||
    action?.action_trace?.trx_id||
    action?.action_trace?.transaction_id||
    action?.id||
    ""
  );
}

async function fetchStakeHistory(days,account,filter,extraParams={}){
  const afterMs=Date.now()-days*24*60*60*1000;
  const afterDate=new Date(afterMs).toISOString();
  const allActions=[];
  const seenIds=new Set();
  const pageLimit=1000;
  let beforeDate="";
  let safetyPages=0;

  while(safetyPages++<10000){
    const params=new URLSearchParams();
    if(account)params.set("account",account);
    if(filter)params.set("filter",filter);
    for(const [key,value] of Object.entries(extraParams)){
      if(value!==undefined&&value!==null&&value!=="")params.set(key,String(value));
    }
    params.set("after",afterDate);
    if(beforeDate)params.set("before",beforeDate);
    params.set("limit",String(pageLimit));
    params.set("skip","0");
    params.set("sort","desc");

    let response;
    try{
      response=await hyperionRequest("/v2/history/get_actions?"+params.toString());
    }catch(error){
      console.warn("Stake history pagination stopped after",allActions.length,"actions:",error);
      break;
    }

    const actions=Array.isArray(response?.actions)?response.actions:
      Array.isArray(response?.data)?response.data:
      Array.isArray(response?.results)?response.results:[];
    if(!actions.length)break;

    let added=0;
    for(const action of actions){
      const id=String(
        action?.trx_id||action?.transaction_id||action?.action_trace?.trx_id||
        action?.action_trace?.transaction_id||action?.id||
        `${getHistoryTimestamp(action)}:${getHistoryActionName(action)}:${getHistoryData(action)?.from||getHistoryData(action)?.owner||""}`
      );
      if(!seenIds.has(id)){
        seenIds.add(id);
        allActions.push(action);
        added++;
      }
    }

    const timestamps=actions.map(getHistoryTimestamp).filter(Number.isFinite);
    if(!timestamps.length)break;
    const oldest=Math.min(...timestamps);

    // Move the cursor backwards by one millisecond instead of using skip.
    // Hyperion installations commonly cap/ignore very large skip offsets;
    // cursor pagination avoids the old 10,000-action ceiling entirely.
    if(oldest<=afterMs)break;
    const nextBeforeMs=oldest-1;
    if(nextBeforeMs<=afterMs)break;
    const nextBefore=new Date(nextBeforeMs).toISOString();
    if(nextBefore===beforeDate||added===0)break;
    beforeDate=nextBefore;

    if(actions.length<pageLimit){
      // There may still be more pages when the server returns a partial page
      // because of its own limits, so continue using the time cursor.
      continue;
    }
  }

  return allActions;
}

function normalizeShortStakeAnalyticsAction(action){
  if(!action)return null;
  if(getHistoryActionName(action)!=="stakexpr")return null;
  const actor=getHistoryActionAccount(action);
  if(actor&&actor!=="eosio")return null;

  const data=getHistoryData(action)||{};
  const account=data.from||data.owner||data.account||data.receiver||action?.act?.authorization?.[0]?.actor||"";
  const amount=stakingAmount(
    data.stake_xpr_quantity||
    data.quantity||
    data.amount||
    data.staked||
    data.stake||
    ""
  );
  const timestamp=getHistoryTimestamp(action);

  if(!account||!amount||!timestamp)return null;
  return {type:"short",account,amount,timestamp,raw:action};
}

function normalizeLongStakeAnalyticsAction(action){
  if(!action)return null;
  if(getHistoryActionName(action)!=="transfer")return null;
  const actor=getHistoryActionAccount(action);
  if(actor&&actor!=="eosio.token")return null;

  const data=getHistoryData(action)||{};
  const to=data.to||"";
  if(to!==LONG_STAKING_CONTRACT)return null;

  const from=data.from||"";
  if(!from||from===LONG_STAKING_CONTRACT||from==="eosio.stake"||from==="eosio.ram"||from==="eosio")return null;

  const quantity=data.quantity||"";
  const amount=stakingAmount(quantity);
  const memo=String(data.memo??"").trim();
  const timestamp=getHistoryTimestamp(action);

  if(!amount||!timestamp)return null;
  const numericMemo=Number(memo);
  return {
    type:"long",
    account:from,
    amount,
    timestamp,
    planIndex:Number.isFinite(numericMemo)?numericMemo:null,
    memo,
    raw:action
  };
}

async function loadStakingHistory(force=false){
  const now=Date.now();
  if(!force&&now-lastStakingHistoryRun<60000)return;
  if(stakingHistoryLoading)return;

  stakingHistoryLoading=true;
  lastStakingHistoryRun=now;

  try{
    const [shortRaw,longRaw]=await Promise.all([
      fetchStakeHistory(30,"eosio","eosio:stakexpr",{
        act_account:"eosio",
        act_name:"stakexpr"
      }),
      fetchStakeHistory(30,LONG_STAKING_CONTRACT,"eosio.token:transfer",{
        act_account:"eosio.token",
        act_name:"transfer",
        transfer_to:LONG_STAKING_CONTRACT
      })
    ]);

    shortStakeHistory=shortRaw
      .map(normalizeShortStakeAnalyticsAction)
      .filter(Boolean);

    longStakeHistory=longRaw
      .map(normalizeLongStakeAnalyticsAction)
      .filter(Boolean);

    renderStakeAnalytics();
  }catch(error){
    console.warn("Staking analytics history lookup failed:",error);
    renderStakeAnalyticsError();
  }finally{
    stakingHistoryLoading=false;
  }
}

function getStakeWindow(events,milliseconds){
  const cutoff=Date.now()-milliseconds;
  const filtered=events.filter(event=>Number(event.timestamp)>=cutoff);
  const count=filtered.length;
  const total=filtered.reduce((sum,event)=>sum+Number(event.amount||0),0);
  const uniqueUsers=new Set(filtered.map(event=>event.account)).size;
  const largest=filtered.length?[...filtered].sort((a,b)=>b.amount-a.amount)[0]:null;
  return {count,total,uniqueUsers,largest};
}

function renderStakeWindow(result,label){
  return `
    <div class="staking-window-card">
      <div class="staking-window-title">${label}</div>
      <div class="staking-window-row"><span>Transactions</span><strong>${formatNumber(result.count)}</strong></div>
      <div class="staking-window-row"><span>Users</span><strong>${formatNumber(result.uniqueUsers)}</strong></div>
      <div class="staking-window-row"><span>Total staked</span><strong>${formatStakingXPR(result.total)}</strong></div>
      <div class="staking-window-row"><span>Average transaction</span><strong>${formatStakingXPR(result.count?result.total/result.count:0)}</strong></div>
      <div class="staking-window-row"><span>Largest stake</span><strong>${result.largest?formatStakingXPR(result.largest.amount):"—"}</strong></div>
      <div class="staking-window-user">
        <div class="staking-window-user-label">Largest staker</div>
        <div class="staking-window-user-value">${escapeHTML(result.largest?.account||"—")}</div>
      </div>
    </div>`;
}

function renderStakeAnalyticsGroup(containerId,events){
  const container=document.getElementById(containerId);
  if(!container)return;
  const windows=[["24h",STAKING_ANALYTICS_WINDOWS["24h"]],["7d",STAKING_ANALYTICS_WINDOWS["7d"]],["30d",STAKING_ANALYTICS_WINDOWS["30d"]]];
  container.innerHTML=windows.map(([label,ms])=>renderStakeWindow(getStakeWindow(events,ms),label)).join("");
