async function getCurrentAccountProducerVotesRaw(account,voterRow){

/*
  Best source: current on-chain voter row. The XPR voter table is the
  authoritative current state. Different RPC/API versions may expose the
  producer list under different field names, so inspect all known layouts.
*/
const direct=getAccountVoteList(voterRow);
if(direct.length)return direct;

/*
  Second source: the most recent voteproducer action. Hyperion supports
  act_account/act_name filters; keep several fallbacks for older deployments.
*/
try{
  const action=await getLatestProducerVoteCached(account);
  const list=getVoteProducerList(action);
  if(list.length)return list;
}catch(error){
  console.warn("Could not read latest voteproducer action:",error);
}

/*
  Final RPC fallback: read the voter row directly from both XPR voter tables
  with a precise primary-key range. Some nodes expose the row only in one of
  these tables.
*/
for(const table of ["votersxpr","voters"]){
  try{
    const result=await rpcRequest("/v1/chain/get_table_rows",{
      json:true,
      code:"eosio",
      scope:"eosio",
      table,
      lower_bound:account,
      upper_bound:account,
      limit:1
    });

    const row=Array.isArray(result?.rows)?result.rows[0]:null;
    const list=getAccountVoteList(row);
    if(list.length)return list;
  }catch(error){
    console.warn("Direct voter table lookup failed:",table,error);
  }
}

return [];

}


function formatAccountTransactionTime(timestamp){
  const date=new Date(timestamp);
  if(!Number.isFinite(date.getTime()))return "—";
  return date.toLocaleString("en-GB",{
    year:"numeric",
    month:"2-digit",
    day:"2-digit",
    hour:"2-digit",
    minute:"2-digit",
    second:"2-digit",
    hour12:false
  });
}

function getAccountTransferAction(action){
  if(!action)return null;
  if(getHistoryActionName(action)!=="transfer")return null;
  const actor=getHistoryActionAccount(action);
  if(actor&&actor!=="eosio.token")return null;

  const data=getHistoryData(action)||{};
  const from=String(data.from||"").trim();
  const to=String(data.to||"").trim();
  const quantity=String(data.quantity||"").trim();
  if(!from||!to||!quantity)return null;

  const match=quantity.replace(/,/g,"").match(/(-?\d+(?:\.\d+)?)\s*XPR\b/i);
  if(!match)return null;
  const amount=Number(match[1]);
  if(!Number.isFinite(amount)||amount<=0)return null;

  const timestamp=getHistoryTimestamp(action);
  const txId=getHistoryTransactionId(action);
  if(!Number.isFinite(timestamp))return null;

  return {from,to,amount,timestamp,txId};
}

let homepageLargeTransfersCache=[];

async function getRecentLargeXPRTransfers(priceUSD, refreshOnly=false){
  if(!Number.isFinite(priceUSD)||priceUSD<=0) return [];

  const minimumUSD=10000;
  const PAGE_LIMIT=1000;
  const MAX_WINDOWS=260; // ~5 years of 7-day windows; stops as soon as 10 are found.
  const WINDOW_DAYS=7;
  const foundMap=new Map();
  const existing=Array.isArray(homepageLargeTransfersCache)?homepageLargeTransfersCache:[];

  function timestampFrom(item){
    const raw=item?.['@timestamp'] ?? item?.block_time ?? item?.action_trace?.['@timestamp'] ??
      item?.action_trace?.block_time ?? item?.action_trace?.block_timestamp ?? item?.action?.block_time ??
      item?.act?.block_time ?? item?.act?.['@timestamp'] ?? item?.created_at ?? item?.timestamp ?? item?.blockTime ?? '';
    if(typeof raw==='number') return raw<1e12 ? raw*1000 : raw;
    const text=String(raw||'').trim();
    if(!text)return 0;
    const n=Number(text);
    if(/^\d+(?:\.\d+)?$/.test(text))return n<1e12?n*1000:n;
    const parsed=Date.parse(text);
    return Number.isFinite(parsed)?parsed:0;
  }

  function normalize(item){
    const data=item?.act?.data || item?.action_trace?.act?.data || item?.action?.act?.data || item?.data || item?.action?.data || item || {};
    const from=String(data.from ?? item?.from ?? '').trim();
    const to=String(data.to ?? item?.to ?? '').trim();
    if(!from||!to)return null;
    let amount=Number(data.amount ?? item?.amount ?? NaN);
    let symbol=String(data.symbol ?? item?.symbol ?? '').toUpperCase().trim();
    const quantity=String(data.quantity ?? item?.quantity ?? '').replace(/,/g,'').trim();
    if(quantity){
      const m=quantity.match(/^(-?\d+(?:\.\d+)?)\s*([A-Z0-9.]+)$/i);
      if(m){amount=Number(m[1]);symbol=m[2].toUpperCase();}
    }
    if(!Number.isFinite(amount)||amount<=0||symbol!=='XPR')return null;
    const timestamp=timestampFrom(item);
    if(!timestamp)return null;
    const txId=String(item?.trx_id ?? item?.transaction_id ?? item?.tx_id ?? item?.id ?? item?.action_trace?.trx_id ?? item?.action_trace?.transaction_id ?? '').trim();
    const blockNum=Number(item?.block_num ?? item?.block_number ?? item?.block ?? 0);
    const usd=amount*priceUSD;
    if(usd<minimumUSD)return null;
    const key=txId || `${from}|${to}|${amount}|${timestamp}|${blockNum}`;
    return {from,to,amount,timestamp,txId,blockNum,usd,key};
  }

  function extract(response){
    if(Array.isArray(response?.actions))return response.actions;
    if(Array.isArray(response?.simple_actions))return response.simple_actions;
    if(Array.isArray(response?.transfers))return response.transfers;
    if(Array.isArray(response?.data))return response.data;
    if(Array.isArray(response?.results))return response.results;
    return [];
  }

  for(const row of existing){
    if(row?.key) foundMap.set(row.key,{...row,usd:row.amount*priceUSD});
  }

  async function request(endpoint,path){
    const controller=new AbortController();
    const timer=setTimeout(()=>controller.abort(),7000);
    try{
      const r=await fetch(endpoint+path,{headers:{Accept:'application/json'},cache:'no-store',signal:controller.signal});
      if(!r.ok)throw new Error('HTTP '+r.status);
      return await r.json();
    }finally{clearTimeout(timer);}
  }

  const endpoints=Array.isArray(HYPERION_ENDPOINTS)&&HYPERION_ENDPOINTS.length
    ?HYPERION_ENDPOINTS
    :['https://proton.protonuk.io','https://api-xprnetwork-main.saltant.io','https://mainnet-api.xprdata.org'];

  async function oneWindow(after,before){
    const q=new URLSearchParams({contract:'eosio.token',symbol:'XPR',limit:String(PAGE_LIMIT)});
    if(after)q.set('after',after);
    if(before)q.set('before',before);
    const path='/v2/history/get_transfers?'+q.toString();
    // Ne uporabljamo več Promise.any: hitrejši endpoint lahko vrne veljaven,
    // vendar nepopoln rezultat. Zberemo odgovore vseh endpointov in jih združimo,
    // da ne izgubimo velikih transakcij.
    const results=await Promise.allSettled(endpoints.map(ep=>request(ep,path)));
    const merged=[];
    for(const result of results){
      if(result.status==='fulfilled') merged.push(...extract(result.value));
    }
    if(merged.length)return {actions:merged};

    const q2=new URLSearchParams({account:'eosio.token',filter:'eosio.token:transfer',act_account:'eosio.token',act_name:'transfer',transfer_symbol:'XPR',limit:String(PAGE_LIMIT),sort:'desc'});
    if(after)q2.set('after',after);
    if(before)q2.set('before',before);
    const fallback='/v2/history/get_actions?'+q2.toString();
    const fallbackResults=await Promise.allSettled(endpoints.map(ep=>request(ep,fallback)));
    const fallbackMerged=[];
    for(const result of fallbackResults){
      if(result.status==='fulfilled') fallbackMerged.push(...extract(result.value));
    }
    if(fallbackMerged.length)return {actions:fallbackMerged};
    throw new Error('No Hyperion endpoint returned transfer data');
  }

  function addResponse(response){
    for(const item of extract(response)){
      const row=normalize(item);
      if(row)foundMap.set(row.key,row);
    }
  }

  // Refreshes only inspect the newest 48 hours and merge into the already known list.
  // This makes the 30-minute refresh fast instead of repeating the full historical scan.
  if(refreshOnly){
    const now=Date.now();
    const after=new Date(now-48*60*60*1000).toISOString();
    const before=new Date(now+60*1000).toISOString();
    try{ addResponse(await oneWindow(after,before)); }catch(e){ console.warn('Large transfer refresh failed:',e); }
  }else{
    // Initial load: scan 7-day windows in parallel batches, newest first.
    // This is much faster than waiting for hundreds of sequential pages.
    let end=Date.now()+60*1000;
    for(let batchStart=0;batchStart<MAX_WINDOWS && foundMap.size<10;batchStart+=8){
      const jobs=[];
      for(let j=0;j<8 && batchStart+j<MAX_WINDOWS;j++){
        const endMs=end-j*WINDOW_DAYS*86400000;
        const startMs=endMs-(WINDOW_DAYS*86400000);
        jobs.push(oneWindow(new Date(startMs).toISOString(),new Date(endMs).toISOString()));
      }
      const results=await Promise.allSettled(jobs);
      for(const result of results){ if(result.status==='fulfilled') addResponse(result.value); }
      const current=[...foundMap.values()].sort((a,b)=>b.timestamp-a.timestamp).slice(0,10);
      const progress=document.getElementById('largeTransfersHome');
      if(progress && current.length<10){
        const checked=Math.min(batchStart+8,MAX_WINDOWS)*WINDOW_DAYS;
        progress.innerHTML=`<div class="account-transactions-empty">Searching transfer history… ${current.length}/10 found · checking last ${checked} days</div>`;
      }
      if(foundMap.size>=10)break;
      end=end-8*WINDOW_DAYS*86400000;
    }
  }

  const rows=[...foundMap.values()]
    .filter(row=>row.amount*priceUSD>=minimumUSD)
    .sort((a,b)=>b.timestamp-a.timestamp)
    .slice(0,10)
    .map(({key,...row})=>row);
  homepageLargeTransfersCache=rows;
  return rows;
}


