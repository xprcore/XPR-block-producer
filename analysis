VOTER WEIGHT
========================================================= */

function getVoterWeight(row){

const possibleValues=[
row.last_vote_weight,
row.vote_weight,
row.staked,
row.stake,
row.voter_stake
];

for(const value of possibleValues){

if(
value!==undefined &&
value!==null &&
value!==""
){

const numericValue=parseAsset(value);

if(Number.isFinite(numericValue)){

return numericValue;

}

}

}

return 0;

}

function voterWeightNumber(value){

const parsed=Number(value);

return Number.isFinite(parsed)
?parsed
:0;

}

/* =========================================================
GET VOTERS FOR PRODUCER
========================================================= */

async function getVotersForProducer(
producerAccount
){

const rows=await getAllVoterRows();

const matches=[];
const seen=new Set();

for(const row of rows){

if(
!producerIsInVoteList(
row,
producerAccount
)
){

continue;

}

const account=
getVoterAccount(row);

if(!account)continue;

if(seen.has(account))continue;

seen.add(account);

const weight=
getVoterWeight(row);

matches.push({
account,
weight
});

}

matches.sort((a,b)=>{

const weightA=
voterWeightNumber(a.weight);

const weightB=
voterWeightNumber(b.weight);

if(weightB!==weightA){
return weightB-weightA;
}

return a.account.localeCompare(
b.account
);

});

return matches;

}

