    requests.push(rpcRequest("/v1/chain/get_block",{block_num_or_id:headBlock-i}).catch(()=>null));
  }
  const blocks=(await Promise.all(requests)).filter(Boolean).sort((a,b)=>Number(b.block_num)-Number(a.block_num));
  latestBlocks=blocks;
  return calculateRecentBlockAnalytics();
}

