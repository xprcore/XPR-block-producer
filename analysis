    "https://api-proton.nodeone.network:8344","https://proton-public.neftyblocks.com",
    "https://api-proton.eosarabia.net","https://api.luminaryvisn.com"
  ];
  async function post(base,path,body){
    const r=await fetch(base+path,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body),cache:"no-store"});
    if(!r.ok)throw new Error(base+" HTTP "+r.status);
    return r.json();
  }
  try{
    const infos=await Promise.all(endpoints.map(async base=>{
      try{const info=await post(base,"/v1/chain/get_info",{});return {base,info,head:Number(info?.head_block_num||0)};}catch(e){return null;}
    }));
    const live=infos.filter(Boolean).filter(x=>x.head>0).sort((a,b)=>b.head-a.head)[0];
    if(!live)throw new Error("No live XPR RPC responded");
    const base=live.base, head=live.head, targetBlock=Math.max(1,head-172800);
    const currentData=await post(base,"/v1/chain/get_table_rows",{json:true,code:"eosio",scope:"eosio",table:"producers",limit:1000,reverse:false,show_payer:false});
    const currentRows=Array.isArray(currentData?.rows)?currentData.rows:[];
    if(!currentRows.length)throw new Error("No current producer rows");
    const historicalData=await post(base,"/v1/chain/get_table_rows",{json:true,code:"eosio",scope:"eosio",table:"producers",limit:1000,reverse:false,show_payer:false,block_num:targetBlock});
    const historicalRows=Array.isArray(historicalData?.rows)?historicalData.rows:[];
    if(!historicalRows.length)throw new Error("No historical producer rows");
    const oldByAccount=new Map();
    for(const row of historicalRows){
      const v=row?.data||row, a=v?.owner||v?.producer||v?.producer_name;
      if(a)oldByAccount.set(String(a).toLowerCase(),v?.total_votes??v?.votes??0);
    }
    const freshMap=new Map();
    for(const p of currentRows){
      const a=String(p?.owner||p?.producer||"").toLowerCase();
      const oldRaw=oldByAccount.get(a);
      if(!a||oldRaw===undefined)continue;
      const current=rawVotesToExplorerVotes(p?.total_votes??p?.votes??0);
      const old=rawVotesToExplorerVotes(oldRaw);
      const delta=current-old;
      if(Number.isFinite(delta))freshMap.set(a,delta);
    }
    if(!freshMap.size)throw new Error("No producer deltas calculated");
    producerData=currentRows;
    for(const [account,delta] of freshMap) producerVotes24hMap.set(account,delta);
    producerVotes24hLoaded=true;
    workingRPC=base;
    renderProducers();
    return true;
  }catch(error){
    console.warn("24h chain fallback unavailable",error);
    // Keep the last valid delta on screen; do not flash the cell empty/loading.
    return false;
  }
}
