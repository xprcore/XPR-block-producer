let homepageLargeTransfersLoading=false;

async function loadHomepageLargeTransfers(refreshOnly=false){
  if(homepageLargeTransfersLoading)return;
  homepageLargeTransfersLoading=true;
  const el=document.getElementById("largeTransfersHome");
  try{
    let price=currentXPRPriceUSD;
    if(!Number.isFinite(price)||price<=0){
      price=await getXPRPriceUSD();
    }
    const rows=await getRecentLargeXPRTransfers(price,refreshOnly);
    renderLargeXPRTransfersHome(rows);
  }catch(error){
    console.warn("Homepage large transfer history failed:",error);
    if(el)el.innerHTML='<div class="account-transactions-empty">Transfer history is temporarily unavailable.</div>';
  }finally{
    homepageLargeTransfersLoading=false;
  }
}

async function searchAccount(){
  if(accountSearchLoading)return;
  const input=document.getElementById("accountSearchInput");
  const button=document.getElementById("accountSearchButton");
  const status=document.getElementById("accountSearchStatus");
  const account=String(input?.value||"").trim().toLowerCase();

  if(!ACCOUNT_NAME_RE.test(account)){
    status.textContent="Neveljaven account. Uporabi 1–12 znakov a-z, 1–5 ali .";
    status.style.color="var(--red)";
    return;
  }

  accountSearchLoading=true;
  if(button){button.disabled=true;button.innerHTML='<span class="loader"></span> Search';}
  status.style.color="var(--muted)";
  status.textContent="Checking account on XPR Network...";

  const modal=document.getElementById("accountModal");
  const content=document.getElementById("accountModalContent");
  document.getElementById("accountModalSub").textContent="Reading live on-chain data...";
  content.innerHTML='<div class="modal-loading"><span class="loader"></span> Loading account data...</div>';
  modal.classList.add("active");

  try{
    // Independent RPC calls run together. The modal is rendered only once,
    // after all requested account fields are ready, so there is no staggered UI.
    const [accountInfo,liquid,voterRow]=await Promise.all([
      getAccountData(account),
      getCurrencyBalance(account),
      getAccountVoterRow(account)
    ]);

    const shortStake=voterRow&&voterRow.staked!==undefined?accountStakeNumber(voterRow.staked):0;

    // Show the account shell as soon as the first, fast RPC calls return.
    // Long-stake and vote history continue in parallel without blocking the modal.
    content.innerHTML=`
      <div class="detail-box" style="margin-bottom:12px">
        <div class="detail-label">XPR Account</div>
        <div class="detail-value">${escapeHTML(account)}</div>
      </div>
      <div class="account-summary-grid">
        <div class="detail-box"><div class="detail-label">Liquid</div><div class="detail-value">${formatAccountXPR(liquid)}</div></div>
        <div class="detail-box"><div class="detail-label">Total USD</div><div class="detail-value" id="accountTotalUSD">Loading…</div></div>
        <div class="detail-box"><div class="detail-label">Short Staked</div><div class="detail-value">${formatAccountXPR(shortStake)}</div></div>
        <div class="detail-box"><div class="detail-label">Long Staked</div><div class="detail-value" id="accountLongStake">Loading…</div></div>
      </div>
      <div class="detail-box" style="margin-top:14px">
        <div class="detail-label">🗳️ Voted Block Producers</div>
        <div id="accountVotesContent" style="margin-top:10px"><span class="muted">Loading…</span></div>
      </div>`;

    status.style.color="var(--green)";
    status.textContent="Account found: "+account;
    document.getElementById("accountModalSub").textContent="Account data";

    // Price and the expensive long-stake lookup are independent. Render USD
    // immediately when the cached/live price arrives, while long stake fills
    // in separately. This removes the old dependency where Total USD waited
    // for the long-stake table scan.
    const longStakePromise=getAccountLongStake(account);
    const pricePromise=getXPRPriceUSD().catch(()=>null);
    const votesPromise=getCurrentAccountProducerVotes(account,voterRow).catch(()=>[]);

    const price=await pricePromise;
    const quickTotalXPR=liquid+shortStake;
    const totalUSDEl=document.getElementById("accountTotalUSD");
    if(totalUSDEl)totalUSDEl.textContent=price!==null?formatAccountUSD(quickTotalXPR*price):"—";

    const longStake=await longStakePromise;
    const longStakeEl=document.getElementById("accountLongStake");
    if(longStakeEl)longStakeEl.textContent=formatAccountXPR(longStake);
    if(totalUSDEl&&price!==null){
      totalUSDEl.textContent=formatAccountUSD((liquid+shortStake+longStake)*price);
    }

    const votedProducers=await votesPromise;
    const voteHTML=votedProducers.length
      ?`<div class="account-votes-list">${votedProducers.map(producer=>`<span class="account-vote-item">${escapeHTML(producer)}</span>`).join("")}</div>`
      :`<div class="account-vote-empty">The current account vote list could not be read from the XPR voter data.</div>`;
    const votesEl=document.getElementById("accountVotesContent");
    if(votesEl)votesEl.innerHTML=voteHTML;

    status.style.color="var(--green)";
    status.textContent="Account found: "+account;
    document.getElementById("accountModalSub").textContent="Account data";
  }catch(error){
    console.error("Account search failed:",error);
    content.innerHTML=`<div class="error"><strong>Account not found / lookup failed</strong><br><br>${escapeHTML(error.message||"The account could not be read from the XPR Network RPC.")}</div>`;
    document.getElementById("accountModalSub").textContent="Unable to read account data.";
    status.style.color="var(--red)";
    status.textContent="Account not found or the RPC returned no data.";
  }finally{
    accountSearchLoading=false;
    if(button){button.disabled=false;button.textContent="Search";}
  }
}

function closeAccountModal(){
  document
    .getElementById("accountModal")
    .classList.remove("active");
}

function closeAccountModalOutside(event){
  if(event.target.id==="accountModal"){
    closeAccountModal();
  }
}

