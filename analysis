  if(!Number.isFinite(n)) return `<span class="producer-votes-24h"></span>`;
  const rounded=Math.round(n);
  const abs=new Intl.NumberFormat("en-US",{maximumFractionDigits:0}).format(Math.abs(rounded));
  if(rounded>0) return `<span class="producer-votes-24h up">+${abs}</span>`;
  if(rounded<0) return `<span class="producer-votes-24h down">-${abs}</span>`;
  return `<span class="producer-votes-24h flat">0</span>`;
}

