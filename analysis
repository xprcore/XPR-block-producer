<!DOCTYPE html>

<html lang="sl">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>XPRCORE · Network Analytics</title>

<style>

:root{
--bg:#03142e;
--bg2:#061d3f;
--panel:#082650;
--panel2:#0b2d5d;
--border:rgba(91,169,248,.18);
--border-strong:rgba(91,169,248,.30);
--text:#f4f8ff;
--muted:#8fa9c7;
--blue:#5aa9f8;
--blue2:#2f80ed;
--purple:#7b2cff;
--green:#42e8a0;
--yellow:#ffd166;
--red:#ff6374;
--shadow:0 18px 55px rgba(0,0,0,.28);
}

*{
box-sizing:border-box
}

html{
scroll-behavior:smooth
}

body{
margin:0;
min-height:100vh;
color:var(--text);
font-family:Arial,Helvetica,sans-serif;
background:
radial-gradient(circle at 8% 0%,rgba(65,145,255,.18),transparent 30%),
radial-gradient(circle at 92% 0%,rgba(124,44,255,.18),transparent 30%),
linear-gradient(180deg,#03142e 0%,#041a38 52%,#020e21 100%);
background-attachment:fixed;
}

.container{
width:min(1450px,calc(100% - 32px));
margin:auto;
padding:22px 0 45px;
}

/* =========================================================
HEADER
========================================================= */

header{
display:flex;
justify-content:space-between;
align-items:center;
gap:20px;
margin-bottom:22px;
}

.brand{
display:flex;
align-items:center;
gap:14px;
}

.logo{
width:58px;
height:58px;
border-radius:50%;
display:grid;
place-items:center;
background:radial-gradient(circle at 50% 45%,rgba(90,169,248,.22),rgba(123,44,255,.12) 52%,transparent 74%);
border:0;
box-shadow:0 0 34px rgba(90,169,248,.16);
overflow:visible;
}

.logo img{
width:52px;
height:52px;
object-fit:contain;
background:transparent;
border:0;
filter:drop-shadow(0 4px 12px rgba(90,169,248,.18));
}

.brand h1{
margin:0;
font-size:21px;
letter-spacing:.1px;
}

.brand p{
margin:5px 0 0;
color:var(--muted);
font-size:12px;
}

/* =========================================================
GLOBAL PANELS
========================================================= */

.panel{
background:
linear-gradient(
180deg,
rgba(8,38,80,.94),
rgba(4,24,52,.97)
);
border:1px solid var(--border);
border-radius:18px;
padding:20px;
box-shadow:var(--shadow);
backdrop-filter:blur(12px);
}

.eyebrow{
color:var(--blue);
font-size:10px;
text-transform:uppercase;
letter-spacing:.13em;
font-weight:bold;
}

h1,h2,h3{
margin-top:0
}

h2{
font-size:18px;
}

.muted{
color:var(--muted);
}

/* =========================================================
HERO
========================================================= */

.hero{
display:grid;
grid-template-columns:2fr 1fr;
gap:16px;
}

.hero-main{
min-height:235px;
display:flex;
flex-direction:column;
justify-content:space-between;
}

.hero-title{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:15px;
}

.hero-title h2{
margin:7px 0 0;
font-size:21px;
}

.live-indicator{
display:inline-flex;
align-items:center;
gap:7px;
padding:7px 10px;
border-radius:20px;
background:rgba(66,232,160,.07);
border:1px solid rgba(66,232,160,.18);
color:var(--green);
font-size:9px;
font-weight:bold;
letter-spacing:.06em;
}

.live-dot{
width:7px;
height:7px;
border-radius:50%;
background:var(--green);
box-shadow:0 0 10px rgba(66,232,160,.6);
}

.metrics{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:10px;
margin-top:25px;
}

.metric{
background:rgba(2,17,36,.55);
border:1px solid rgba(90,169,248,.13);
border-radius:13px;
padding:14px;
min-width:0;
}

.metric-label{
color:var(--muted);
font-size:9px;
text-transform:uppercase;
letter-spacing:.08em;
}

.metric-value{
margin-top:7px;
font-size:18px;
font-weight:bold;
word-break:break-word;
}

.list-row{
display:flex;
justify-content:space-between;
align-items:center;
gap:18px;
padding:12px 0;
border-bottom:1px solid rgba(91,169,248,.13);
}

.list-row:last-child{
border-bottom:0;
}

.list-row small{
display:block;
color:var(--muted);
margin-top:4px;
font-size:10px;
line-height:1.4;
}

/* =========================================================
BUTTONS / TABS
========================================================= */

button{
border:0;
border-radius:10px;
padding:10px 16px;
font-weight:bold;
cursor:pointer;
transition:.18s ease;
}

button:hover{
transform:translateY(-1px);
}

button:disabled{
opacity:.7;
cursor:wait;
transform:none;
}

.primary{
color:white;
background:linear-gradient(135deg,var(--blue2),var(--purple));
box-shadow:0 8px 25px rgba(77,105,255,.20);
}

.secondary{
color:white;
background:rgba(255,255,255,.045);
border:1px solid var(--border);
}

.tabs{
display:flex;
gap:7px;
margin:18px 0;
}

.tab{
color:#9eb7d3;
background:rgba(8,35,70,.72);
border:1px solid rgba(90,169,248,.16);
padding:10px 18px;
min-width:140px;
}

.tab:hover{
color:white;
border-color:rgba(90,169,248,.42);
}

.tab.active{
color:white;
border-color:rgba(90,169,248,.55);
background:linear-gradient(
135deg,
rgba(47,128,237,.34),
rgba(123,44,255,.30)
);
box-shadow:0 0 22px rgba(77,105,255,.10);
}

.section{
display:none;
}

.section.active{
display:block;
}

/* =========================================================
NETWORK LAYOUT
========================================================= */

.network-layout{
display:grid;
grid-template-columns:1fr;
gap:16px;
}

.analytics-panel{
min-width:0;
}

.analytics-header{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:18px;
padding-bottom:18px;
border-bottom:1px solid rgba(91,169,248,.12);
}

.analytics-title h2{
margin:6px 0 4px;
font-size:20px;
}

.analytics-title p{
margin:0;
color:var(--muted);
font-size:11px;
line-height:1.5;
}

.analytics-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
margin-top:14px;
}

.analytics-card{
padding:14px;
border-radius:13px;
background:rgba(2,17,36,.52);
border:1px solid rgba(90,169,248,.13);
min-width:0;
}

.analytics-card .label{
font-size:9px;
color:var(--muted);
text-transform:uppercase;
letter-spacing:.08em;
}

.analytics-card .value{
font-size:21px;
font-weight:bold;
margin-top:8px;
word-break:break-word;
}

.analytics-card .sub{
font-size:9px;
color:var(--muted);
margin-top:5px;
line-height:1.4;
}

/* =========================================================
HEALTH
========================================================= */

.health-panel{
margin-top:14px;
padding:17px;
border-radius:14px;
background:
linear-gradient(
135deg,
rgba(66,232,160,.055),
rgba(90,169,248,.035)
);
border:1px solid rgba(66,232,160,.14);
}

.health-top{
display:flex;
justify-content:space-between;
align-items:center;
gap:18px;
}

.health-main{
display:flex;
align-items:center;
gap:13px;
}

.health-dot{
width:11px;
height:11px;
border-radius:50%;
background:var(--green);
box-shadow:0 0 15px rgba(66,232,160,.5);
flex-shrink:0;
}

.health-label{
font-size:9px;
color:var(--muted);
text-transform:uppercase;
letter-spacing:.08em;
}

.health-score{
font-size:32px;
font-weight:bold;
line-height:1;
margin-top:4px;
}

.health-status{
text-align:right;
}

.health-status strong{
font-size:11px;
}

.health-copy{
font-size:10px;
color:var(--muted);
margin-top:5px;
line-height:1.45;
}

.health-bar{
height:5px;
margin-top:16px;
background:rgba(255,255,255,.05);
border-radius:10px;
overflow:hidden;
}

.health-bar-fill{
height:100%;
width:0%;
border-radius:10px;
background:linear-gradient(90deg,var(--blue2),var(--green));
transition:width .5s ease;
}

/* =========================================================
ANALYSIS
========================================================= */

.analysis-grid{
display:grid;
grid-template-columns:1fr;
gap:12px;
margin-top:14px;
}

.analysis-card{
padding:15px;
border-radius:13px;
background:rgba(2,17,36,.42);
border:1px solid rgba(90,169,248,.11);
}

.analysis-title{
font-size:9px;
color:var(--muted);
text-transform:uppercase;
letter-spacing:.09em;
margin-bottom:12px;
}

.progress{
height:7px;
background:rgba(255,255,255,.055);
border-radius:10px;
overflow:hidden;
margin-top:8px;
}

.progress-bar{
height:100%;
border-radius:10px;
background:linear-gradient(90deg,var(--blue2),var(--purple));
transition:width .5s ease;
}

/* =========================================================
PRODUCER TABLES
========================================================= */

.producer-panel{
margin-top:0;
}

.table-wrap{
overflow-x:auto;
margin-top:16px;
}

table{
width:100%;
border-collapse:separate;
border-spacing:0 7px;
min-width:900px;
}

th{
color:var(--muted);
font-size:9px;
text-transform:uppercase;
letter-spacing:.09em;
padding:7px 10px;
text-align:left;
}

td{
padding:11px 10px;
background:rgba(3,19,40,.68);
border-top:1px solid rgba(90,169,248,.09);
border-bottom:1px solid rgba(90,169,248,.09);
font-size:12px;
}

td:first-child{
border-left:1px solid rgba(90,169,248,.09);
border-radius:9px 0 0 9px;
}

td:last-child{
border-right:1px solid rgba(90,169,248,.09);
border-radius:0 9px 9px 0;
}

tbody tr{
transition:.16s ease;
}

tbody tr:hover td{
background:rgba(45,111,190,.16);
border-color:rgba(90,169,248,.24);
}

.producer-clickable-row{
cursor:pointer;
}

.producer-name{
display:flex;
align-items:center;
gap:9px;
}




.producer-name strong{
color:white;
}

.producer-name small{
display:block;
color:var(--muted);
margin-top:3px;
font-size:9px;
}

.clickable-name{
color:white;
}

.clickable-name:hover{
color:var(--blue);
}

.badge{
display:inline-flex;
align-items:center;
justify-content:center;
padding:5px 9px;
border-radius:20px;
font-size:8px;
font-weight:bold;
letter-spacing:.05em;
white-space:nowrap;
}

.active-badge{
color:var(--green);
background:rgba(66,232,160,.08);
border:1px solid rgba(66,232,160,.17);
}

.top-badge{
color:var(--blue);
background:rgba(90,169,248,.08);
border:1px solid rgba(90,169,248,.18);
}

.producing-badge{
color:white;
background:linear-gradient(
135deg,
rgba(66,232,160,.22),
rgba(47,128,237,.22)
);
border:1px solid rgba(66,232,160,.48);
box-shadow:0 0 16px rgba(66,232,160,.18);
animation:producingPulse 1s infinite alternate;
}

.inactive-badge{
color:var(--yellow);
background:rgba(255,209,102,.08);
border:1px solid rgba(255,209,102,.17);
}

@keyframes producingPulse{
from{
box-shadow:0 0 5px rgba(66,232,160,.12)
}
to{
box-shadow:0 0 20px rgba(66,232,160,.34)
}
}

.producer-votes-stack{
display:flex;
flex-direction:column;
align-items:flex-start;
gap:3px;
min-width:150px;
}
.producer-votes-24h{
font-size:11px;
font-weight:700;
line-height:1.2;
white-space:nowrap;
}
.producer-votes-24h.up{color:var(--green);}
.producer-votes-24h.down{color:#ff6b6b;}
.producer-votes-24h.flat{color:var(--muted);}


.producer-rank-movement{
display:inline-flex;
align-items:center;
justify-content:center;
min-width:0;
margin-left:4px;
font-size:11px;
font-weight:800;
font-variant-numeric:tabular-nums;
}
.producer-rank-movement.up{color:var(--green);}
.producer-rank-movement.down{color:#ff6b6b;}
.producer-rank-movement.flat{min-width:0;}

.votes-box{
display:inline-flex;
align-items:center;
justify-content:center;
min-width:150px;
padding:8px 11px;
border-radius:9px;
background:linear-gradient(
135deg,
rgba(47,128,237,.10),
rgba(123,44,255,.10)
);
border:1px solid rgba(90,169,248,.20);
color:#eaf5ff;
font-size:13px;
font-weight:bold;
white-space:nowrap;
}

.location-code{
display:inline-flex;
align-items:center;
justify-content:center;
min-width:36px;
padding:5px 7px;
border-radius:7px;
color:var(--blue);
background:rgba(90,169,248,.07);
border:1px solid rgba(90,169,248,.16);
font-size:10px;
font-weight:bold;
}

.website-link{
color:var(--blue);
text-decoration:none;
font-size:10px;
display:inline-block;
max-width:190px;
overflow:hidden;
text-overflow:ellipsis;
white-space:nowrap;
}

.website-link:hover{
color:white;
text-decoration:underline;
}

/* =========================================================
STAKING
========================================================= */

.staking-status{
font-size:10px;
color:var(--muted);
margin-top:5px;
}

.staking-number{
font-variant-numeric:tabular-nums;
}

.staking-table table{
min-width:760px;
}

.staking-table .votes-box{
min-width:170px;
}

.stake-date{
white-space:nowrap;
color:#eaf5ff;
}

.stake-time{
white-space:nowrap;
color:var(--muted);
}

.stake-amount{
font-weight:bold;
color:#eaf5ff;
white-space:nowrap;
}

.staking-source{
font-size:9px;
color:var(--muted);
margin-top:12px;
line-height:1.5;
}

.market-panel{

min-height:235px;

}

.market-stats{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:10px;

margin-top:18px;

}

.market-stat{

background:rgba(2,17,36,.55);

border:1px solid rgba(90,169,248,.13);

border-radius:13px;

padding:13px;

min-width:0;

}

.market-stat .label{

color:var(--muted);

font-size:9px;

text-transform:uppercase;

letter-spacing:.08em;

}

.market-stat .value{

margin-top:7px;

font-size:17px;

font-weight:800;

white-space:nowrap;

overflow:hidden;

text-overflow:ellipsis;

}

.market-change{

margin-top:4px;

font-size:9px;

font-weight:700;

}

.market-change.up{color:var(--green)}

.market-change.down{color:#ff6b81}

.price-chart-wrap{

margin-top:16px;

}

.price-chart-toolbar{

display:flex;

justify-content:space-between;

align-items:center;

gap:10px;

margin-bottom:8px;

}

.price-chart-title{

font-size:11px;

font-weight:800;

}

.price-chart-updated{

color:var(--muted);

font-size:9px;

}

.price-range-buttons{

display:flex;

gap:5px;

}

.price-range-button{

border:1px solid rgba(90,169,248,.18);

background:rgba(2,17,36,.42);

color:var(--muted);

border-radius:8px;

padding:6px 9px;

font-size:9px;

font-weight:800;

cursor:pointer;

}

.price-range-button:hover,

.price-range-button.active{

color:#fff;

border-color:rgba(90,169,248,.45);

background:rgba(90,169,248,.12);

}

.price-chart{

width:100%;

height:145px;

display:block;

overflow:visible;

}

.price-chart-empty{

height:145px;

display:grid;

place-items:center;

color:var(--muted);

font-size:10px;

}

@media(max-width:1050px){

.hero{grid-template-columns:1fr;}

}

@media(max-width:750px){

.market-stats{grid-template-columns:1fr 1fr 1fr;}

.price-chart-toolbar{align-items:flex-start;flex-direction:column;}

.price-range-buttons{width:100%;}

.price-range-button{flex:1;}

}

@media(max-width:480px){

.market-stats{grid-template-columns:1fr;}

}

/* =========================================================
NETWORK LIVE ANALYTICS / CHARTS
========================================================= */
.live-analytics-metrics{grid-template-columns:repeat(4,1fr);margin-top:18px}
.network-performance-grid{grid-template-columns:repeat(4,1fr)}
.network-status-line{margin-top:12px;padding:10px 12px;border-radius:10px;background:rgba(2,17,36,.42);border:1px solid rgba(90,169,248,.10);font-size:9px;color:var(--muted);display:flex;gap:8px;align-items:center}
.network-status-line #analyticsStatus{font-weight:800;color:var(--green);letter-spacing:.06em}
.network-charts-panel{margin-top:0}
.chart-header{align-items:center}
.timeframe-buttons{display:flex;gap:5px;flex-wrap:wrap}
.timeframe-button{padding:7px 10px;font-size:9px;color:var(--muted);background:rgba(2,17,36,.42);border:1px solid rgba(90,169,248,.16);border-radius:8px}
.timeframe-button.active{color:#fff;border-color:rgba(90,169,248,.45);background:rgba(90,169,248,.12)}
.network-chart-card{margin-top:12px;padding:12px;border-radius:13px;background:rgba(2,17,36,.42);border:1px solid rgba(90,169,248,.10)}
.network-chart-title{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.09em;font-weight:800;margin-bottom:8px}
.network-chart{width:100%;height:190px;display:block}
.validator-chart{height:220px}
.network-chart-updated{margin-top:10px;color:var(--muted);font-size:8px}
@media(max-width:1050px){.live-analytics-metrics,.network-performance-grid{grid-template-columns:repeat(2,1fr)}.chart-header{align-items:flex-start;flex-direction:column}.timeframe-buttons{width:100%}.timeframe-button{flex:1}}
@media(max-width:480px){.live-analytics-metrics,.network-performance-grid{grid-template-columns:1fr}.network-chart{height:165px}.validator-chart{height:210px}}

/* =========================================================
MODAL
========================================================= */

.modal{
position:fixed;
inset:0;
z-index:9999;
display:none;
align-items:center;
justify-content:center;
padding:20px;
background:rgba(0,7,20,.78);
backdrop-filter:blur(8px);
}

.modal.active{
display:flex;
}

.modal-card{
width:min(700px,100%);
max-height:90vh;
overflow-y:auto;
background:linear-gradient(
180deg,
rgba(9,39,78,.98),
rgba(4,24,52,.99)
);
border:1px solid var(--border);
border-radius:18px;
padding:22px;
box-shadow:0 30px 100px rgba(0,0,0,.55);
}

.modal-header{
display:flex;
justify-content:space-between;
align-items:center;
gap:15px;
margin-bottom:18px;
}

.close-button{
width:38px;
height:38px;
padding:0;
color:white;
background:rgba(255,255,255,.07);
border:1px solid var(--border);
border-radius:10px;
font-size:18px;
}

.detail-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:10px;
}

.detail-box{
padding:14px;
border:1px solid var(--border);
border-radius:11px;
background:rgba(2,17,36,.5);
}

.detail-label{
color:var(--muted);
font-size:9px;
text-transform:uppercase;
letter-spacing:.08em;
}

.detail-value{
margin-top:7px;
color:white;
font-size:15px;
font-weight:bold;
word-break:break-word;
}

.vote-list{
margin-top:13px;
max-height:380px;
overflow-y:auto;
}

.vote-item{
display:inline-block;
margin:4px 5px 4px 0;
padding:7px 9px;
border-radius:8px;
color:var(--blue);
background:rgba(90,169,248,.07);
border:1px solid rgba(90,169,248,.16);
font-size:11px;
}

.voter-row{
display:flex;
justify-content:space-between;
align-items:center;
gap:12px;
padding:9px 11px;
margin-bottom:6px;
border:1px solid rgba(90,169,248,.11);
border-radius:8px;
background:rgba(2,17,36,.42);
}

.voter-account{
color:white;
font-weight:bold;
font-size:11px;
}

.voter-weight{
color:var(--muted);
font-size:10px;
text-align:right;
}

.modal-loading{
padding:25px 0;
text-align:center;
color:var(--muted);
}

/* =========================================================
MESSAGES / LOADER
========================================================= */

.error{
margin-top:16px;
padding:14px;
border-radius:11px;
color:#ffadb5;
background:rgba(255,107,120,.07);
border:1px solid rgba(255,107,120,.25);
font-size:12px;
}

.loader{
display:inline-block;
width:15px;
height:15px;
border:2px solid rgba(255,255,255,.18);
border-top-color:var(--blue);
border-radius:50%;
animation:spin .7s linear infinite;
vertical-align:middle;
}

@keyframes spin{
to{
transform:rotate(360deg)
}
}

footer{
text-align:center;
margin-top:32px;
color:var(--muted);
font-size:10px;
}


/* =========================================================
ACCOUNT SEARCH
========================================================= */

.account-search-panel{
  margin:16px 0;
}

.account-search-layout{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(280px,420px);
  gap:16px;
  align-items:stretch;
}

.account-search-copy{
  min-width:0;
}

.account-search-copy h2{
  margin:7px 0 5px;
}

.account-search-copy p{
  margin:0;
  color:var(--muted);
  font-size:11px;
  line-height:1.55;
}

.account-search-form{
  display:flex;
  gap:8px;
  align-items:center;
}

.account-search-input{
  flex:1;
  min-width:0;
  height:42px;
  padding:0 13px;
  border-radius:10px;
  border:1px solid var(--border);
  background:rgba(2,17,36,.62);
  color:white;
  outline:none;
  font-size:12px;
}

.account-search-input::placeholder{
  color:#7189a7;
}

.account-search-input:focus{
  border-color:rgba(90,169,248,.55);
  box-shadow:0 0 0 3px rgba(90,169,248,.07);
}

.account-search-button{
  height:42px;
  white-space:nowrap;
}

.account-search-status{
  margin-top:8px;
  color:var(--muted);
  font-size:9px;
  min-height:14px;
}

.account-modal-card{
  width:min(760px,100%);
}

.account-hero{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:15px;
  margin-bottom:16px;
}

.account-hero-name{
  font-size:22px;
  font-weight:bold;
  margin-top:6px;
}

.account-hero-sub{
  color:var(--muted);
  font-size:10px;
  margin-top:4px;
}

.account-summary-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
}

.account-summary-grid .detail-box{
  min-height:84px;
}

.account-summary-grid .detail-value{
  font-size:17px;
}

.account-votes-panel{
  margin-top:12px;
}

.account-votes-list{
  display:flex;
  flex-direction:column;
  gap:6px;
  margin-top:11px;
}

.account-vote-item{
  display:flex;
  align-items:center;
  width:100%;
  min-height:42px;
  padding:8px 10px;
  border-radius:9px;
  color:#eaf5ff;
  background:linear-gradient(
    135deg,
    rgba(47,128,237,.12),
    rgba(123,44,255,.12)
  );
  border:1px solid rgba(90,169,248,.20);
  font-size:11px;
  font-weight:bold;
}

.account-vote-empty{
  color:var(--muted);
  font-size:11px;
  line-height:1.5;
  margin-top:10px;
}

/* Account transfer history */
.account-transactions-panel{
  margin-top:12px;
}
.account-transactions-table{
  width:100%;
  border-collapse:collapse;
  margin-top:10px;
  font-size:10px;
}
.account-transactions-table th{
  text-align:left;
  color:var(--muted);
  font-size:8px;
  text-transform:uppercase;
  letter-spacing:.06em;
  padding:7px 6px;
  border-bottom:1px solid var(--border);
}
.account-transactions-table td{
  padding:8px 6px;
  border-bottom:1px solid rgba(255,255,255,.06);
  color:#eaf5ff;
  vertical-align:top;
}
.account-transactions-table .amount{
  font-weight:bold;
  white-space:nowrap;
}
.account-transactions-table .tx-time{
  white-space:nowrap;
  color:var(--muted);
}
.account-transactions-empty{
  color:var(--muted);
  font-size:10px;
  line-height:1.5;
  margin-top:10px;
}

.account-modal-source{
  margin-top:12px;
  color:var(--muted);
  font-size:9px;
  line-height:1.5;
}

@media(max-width:750px){
  .account-search-layout{
    grid-template-columns:1fr;
  }

  .account-search-form{
    width:100%;
  }
}

@media(max-width:480px){
  .account-summary-grid{
    grid-template-columns:1fr;
  }

  .account-search-form{
    flex-direction:column;
    align-items:stretch;
  }

  .account-search-button{
    width:100%;
  }
}



/* =========================================================
COMPACT LARGE TRANSFERS CARD
========================================================= */
.large-transfers-home-panel{
  padding:12px;
  max-width:720px;
  box-sizing:border-box;
}
.large-transfers-home-panel .analytics-header{
  padding-bottom:6px;
  gap:6px;
}
.large-transfers-home-panel .analytics-title h2{
  font-size:14px;
  margin:2px 0 0;
}
.large-transfers-home-panel .analytics-title .eyebrow{
  font-size:8px;
}
.large-transfers-home-panel .account-transactions-table{
  margin-top:4px;
  font-size:8px;
  table-layout:fixed;
}
.large-transfers-home-panel .account-transactions-table th{
  font-size:7px;
  padding:4px 4px;
}
.large-transfers-home-panel .account-transactions-table td{
  padding:5px 4px;
  line-height:1.15;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.large-transfers-home-panel .account-transactions-table th:nth-child(1),
.large-transfers-home-panel .account-transactions-table td:nth-child(1){width:24%;}
.large-transfers-home-panel .account-transactions-table th:nth-child(2),
.large-transfers-home-panel .account-transactions-table td:nth-child(2){width:19%;}
.large-transfers-home-panel .account-transactions-table th:nth-child(3),
.large-transfers-home-panel .account-transactions-table td:nth-child(3){width:19%;}
.large-transfers-home-panel .account-transactions-table th:nth-child(4),
.large-transfers-home-panel .account-transactions-table td:nth-child(4){width:19%;}
.large-transfers-home-panel .account-transactions-table th:nth-child(5),
.large-transfers-home-panel .account-transactions-table td:nth-child(5){width:19%;}
.large-transfers-home-panel .account-transactions-empty{
  font-size:9px;
  margin-top:5px;
}
@media(max-width:700px){
  .large-transfers-home-panel{max-width:100%;}
}

/* =========================================================
