function switchTab(tabName){

document
.querySelectorAll(".section")
.forEach(section=>{

section.classList.toggle(
"active",
section.id===tabName
);

});

document
.querySelectorAll(".tab")
.forEach(button=>{

button.classList.toggle(
"active",
button.dataset.tab===tabName
);

});

if(tabName==="staking"){

loadStaking();

}

}

document
.querySelectorAll(".tab")
.forEach(button=>{

button.addEventListener(
"click",
()=>{
switchTab(
button.dataset.tab
);
}
);

});

