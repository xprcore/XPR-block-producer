function formatMarketPrice(value){
const n=Number(value);
if(!Number.isFinite(n)) return "—";
return "$"+n.toFixed(6);
}

function formatMarketMoney(value){
const n=Number(value);
if(!Number.isFinite(n)) return "—";
if(Math.abs(n)>=1e9) return "$"+(n/1e9).toFixed(2)+"B";
if(Math.abs(n)>=1e6) return "$"+(n/1e6).toFixed(2)+"M";
return "$"+n.toLocaleString("en-US",{maximumFractionDigits:0});
}

function formatMarketSupply(value){
const n=Number(value);
if(!Number.isFinite(n)) return "—";
if(n>=1e9) return (n/1e9).toFixed(2)+"B XPR";
if(n>=1e6) return (n/1e6).toFixed(2)+"M XPR";
return n.toLocaleString("en-US",{maximumFractionDigits:0})+" XPR";
}

function findMarketNumber(value,keys,depth=0){
if(depth>5||value===null||value===undefined)return null;
if(typeof value==='number')return Number.isFinite(value)?value:null;
if(Array.isArray(value)){
for(const x of value){const n=findMarketNumber(x,keys,depth+1);if(n!==null)return n;}
return null;
}
if(typeof value!=='object')return null;
for(const k of keys){
if(Object.prototype.hasOwnProperty.call(value,k)){
const n=Number(String(value[k]).replace(/,/g,''));
if(Number.isFinite(n))return n;
}
}
for(const k of Object.keys(value)){const n=findMarketNumber(value[k],keys,depth+1);if(n!==null)return n;}
return null;
}

async function getXPRCirculatingSupply(){
try{
const response=await fetch(RPC_ENDPOINTS[0]+"/v1/chain/get_currency_stats",{
method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},
body:JSON.stringify({code:"eosio.token",symbol:"XPR"}),cache:"no-store"
});
if(!response.ok) return null;
const data=await response.json();
const row=data?.XPR;
if(!row?.supply)return null;
const m=String(row.supply).replace(/,/g,"").match(/-?\d+(?:\.\d+)?/);
return m?Number(m[0]):null;
}catch(e){return null;}
}

async function loadMarketData(){
if(marketLoading)return;
marketLoading=true;
try{
const [dailyResponse,depthResponse,supply]=await Promise.all([
fetch(METALX_MARKET_DAILY_ENDPOINT,{cache:"no-store",headers:{Accept:"application/json"}}).catch(()=>null),
fetch(METALX_MARKET_PRICE_ENDPOINT,{cache:"no-store",headers:{Accept:"application/json"}}).catch(()=>null),
getXPRCirculatingSupply()
]);

let price=null;
let change=null;

// Metal X daily ticker is the authoritative source for the last traded XPR/XMD price.
// XMD is used as the USD reference in this dashboard.
if(dailyResponse&&dailyResponse.ok){
try{
const daily=await dailyResponse.json();
const d=daily?.data ?? daily;

// The daily endpoint can return multiple markets. Always select the XPR/XMD
// row first so price and 24h change come from the exact same Metal X market.
function findMetalXMarketRow(value, depth=0){
  if(depth>6 || value===null || value===undefined) return null;
  if(Array.isArray(value)){
    for(const item of value){
      const row=findMetalXMarketRow(item,depth+1);
      if(row) return row;
    }
    return null;
  }
  if(typeof value!=="object") return null;
  const symbol=String(value.symbol ?? value.market ?? value.pair ?? value.market_symbol ?? "").toUpperCase();
  if(symbol===METALX_MARKET_SYMBOL || symbol==="XPR/XMD" || symbol==="XPR-XMD") return value;
  for(const key of Object.keys(value)){
    const row=findMetalXMarketRow(value[key],depth+1);
    if(row) return row;
  }
  return null;
}

const marketRow=findMetalXMarketRow(d) || d;
price=findMarketNumber(marketRow,["last_price","lastPrice","last","close"]);

// Metal X's daily ticker `change` value is already the 24h percentage
// change for the selected XPR/XMD market. Do NOT recalculate it from price
// (doing so treats the percentage as an absolute price move and produces
// wildly inflated values such as 100%+). Prefer explicit percentage fields
// when available, otherwise use `change` exactly as Metal X reports it.
function findMarketPercent(value,keys,depth=0){
  if(depth>5||value===null||value===undefined)return null;
  if(Array.isArray(value)){
    for(const x of value){const n=findMarketPercent(x,keys,depth+1);if(n!==null)return n;}
    return null;
  }
  if(typeof value!=="object")return null;
  for(const k of keys){
    if(Object.prototype.hasOwnProperty.call(value,k)){
      const raw=value[k];
      const n=Number(String(raw).replace(/,/g,"").replace(/%/g,""));
      if(Number.isFinite(n))return n;
    }
  }
  for(const k of Object.keys(value)){const n=findMarketPercent(value[k],keys,depth+1);if(n!==null)return n;}
  return null;
}

change=findMarketPercent(marketRow,["changePercent","change_percentage","percentChange","percentageChange","change"]);
}catch(e){console.warn("Metal X daily ticker parse failed:",e);}
}

// Fallback: calculate a mid-price from the best bid/ask, never from arbitrary numbers
// elsewhere in the JSON response.
if(price===null && depthResponse&&depthResponse.ok){
try{
const depthJson=await depthResponse.json();
const d=depthJson?.data ?? depthJson;
const bids=Array.isArray(d?.bids)?d.bids:[];
const asks=Array.isArray(d?.asks)?d.asks:[];
const bid=Number(Array.isArray(bids[0])?bids[0][0]:(bids[0]?.price ?? bids[0]?.rate));
const ask=Number(Array.isArray(asks[0])?asks[0][0]:(asks[0]?.price ?? asks[0]?.rate));
if(Number.isFinite(bid)&&Number.isFinite(ask)&&bid>0&&ask>0) price=(bid+ask)/2;
else if(Number.isFinite(bid)&&bid>0) price=bid;
else if(Number.isFinite(ask)&&ask>0) price=ask;
}catch(e){console.warn("Metal X depth fallback parse failed:",e);}
}

if(price!==null){
document.getElementById("marketPrice").textContent=formatMarketPrice(price);
currentXPRPriceUSD=price;
}else document.getElementById("marketPrice").textContent="—";

if(supply!==null){
document.getElementById("marketSupply").textContent=formatMarketSupply(supply);
if(price!==null)document.getElementById("marketCap").textContent=formatMarketMoney(price*supply);
else document.getElementById("marketCap").textContent="—";
}else{
document.getElementById("marketSupply").textContent="—";
document.getElementById("marketCap").textContent="—";
}

const changeEl=document.getElementById("marketPriceChange");
if(Number.isFinite(Number(change))){
changeEl.textContent=(change>=0?"▲ ":"▼ ")+Math.abs(change).toFixed(2)+"% 24h";
changeEl.className="market-change "+(change>=0?"up":"down");
}else{
changeEl.textContent="—";
changeEl.className="market-change";
}
}catch(error){
console.warn("Metal X market data failed:",error);
}
finally{marketLoading=false;}
}

function setPriceRange(days,button){

selectedPriceRange=Number(days)||1;

document.querySelectorAll(".price-range-button").forEach(el=>el.classList.remove("active"));

if(button)button.classList.add("active");

loadPriceHistory();

}

function renderPriceChart(points){

const container=document.getElementById("priceChartContainer");

if(!container)return;

if(!points.length){container.className="price-chart-empty";container.textContent="No price history available.";return;}

const width=760,height=145,padX=6,padTop=10,padBottom=20;

const prices=points.map(p=>Number(p[1])).filter(Number.isFinite);

const min=Math.min(...prices),max=Math.max(...prices);

const span=(max-min)||Math.max(max*0.02,0.000001);

const coords=points.map((p,i)=>{

const x=padX+(i/(Math.max(points.length-1,1)))*(width-padX*2);

const y=padTop+(1-(Number(p[1])-min)/span)*(height-padTop-padBottom);

return [x,y];

});

const line=coords.map((p,i)=>(i?"L":"M")+p[0].toFixed(2)+" "+p[1].toFixed(2)).join(" ");

const area=line+" L "+coords[coords.length-1][0].toFixed(2)+" "+(height-padBottom)+" L "+coords[0][0].toFixed(2)+" "+(height-padBottom)+" Z";

const last=prices[prices.length-1];

const first=prices[0];

const delta=((last-first)/first)*100;

container.className="";

container.innerHTML=`<svg class="price-chart" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" role="img" aria-label="XPR price history">

<line x1="0" y1="${height-padBottom}" x2="${width}" y2="${height-padBottom}" stroke="rgba(91,169,248,.12)" stroke-width="1"/>

<line x1="0" y1="${padTop}" x2="${width}" y2="${padTop}" stroke="rgba(91,169,248,.08)" stroke-width="1"/>

<path d="${area}" fill="rgba(90,169,248,.10)" stroke="none"/>

<path d="${line}" fill="none" stroke="rgba(90,169,248,.95)" stroke-width="2" vector-effect="non-scaling-stroke"/>

<circle cx="${coords[coords.length-1][0]}" cy="${coords[coords.length-1][1]}" r="3.2" fill="rgba(90,169,248,1)"/>

<text x="4" y="${height-5}" fill="rgba(180,202,228,.65)" font-size="9">${formatMarketPrice(min)}</text>

<text x="${width-4}" y="${padTop+8}" text-anchor="end" fill="rgba(180,202,228,.65)" font-size="9">${formatMarketPrice(max)}</text>

</svg>`;

document.getElementById("priceChartUpdated").textContent=(delta>=0?"▲ ":"▼ ")+Math.abs(delta).toFixed(2)+"% over "+(selectedPriceRange===365?"1 year":selectedPriceRange+" day"+(selectedPriceRange===1?"":"s"));

}

async function loadPriceHistory(){
if(marketHistoryLoading)return;
marketHistoryLoading=true;
const container=document.getElementById("priceChartContainer");
try{
const now=new Date();
const from=new Date(now.getTime()-selectedPriceRange*24*60*60*1000);
const qs=new URLSearchParams({
interval:selectedPriceRange===1?"60":(selectedPriceRange<=30?"240":"1D"),
from:from.toISOString(),
to:now.toISOString(),
symbol:METALX_MARKET_SYMBOL,
limit:"500"
});
const response=await fetch(METALX_MARKET_HISTORY_ENDPOINT+"?"+qs.toString(),{cache:"no-store",headers:{Accept:"application/json"}});
if(!response.ok)throw new Error("Metal X OHLCV returned HTTP "+response.status);
const data=await response.json();
const rows=Array.isArray(data)?data:(data?.data||data?.results||data?.candles||data?.items||[]);
const points=[];
for(const row of rows){
let ts,close;
if(Array.isArray(row)){ts=Number(row[0]);close=Number(row[4]);}
else if(row&&typeof row==='object'){
ts=Number(row.timestamp??row.time??row.ts??row.date);
close=Number(row.close??row.c??row.last_price??row.price);
}
if(Number.isFinite(close)&&close>0){
if(Number.isFinite(ts)&&ts<1e12)ts*=1000;
points.push([Number.isFinite(ts)?ts:points.length,close]);
}
}
points.sort((a,b)=>a[0]-b[0]);
renderPriceChart(points);
}catch(error){
console.warn("Metal X price history failed:",error);
container.className="price-chart-empty";
container.textContent="Price history temporarily unavailable.";
document.getElementById("priceChartUpdated").textContent="Waiting for Metal X market data...";
}finally{marketHistoryLoading=false;}
}

