function scheduleProducerNames(schedule){
  const list=Array.isArray(schedule?.producers)?schedule.producers:[];
  return list.map(p=>String(p?.producer_name||p?.name||'').trim()).filter(Boolean);
}

function expectedSlotsForProducer(scheduleEntries,name,startBlock,endBlock){
  if(!scheduleEntries.length||endBlock<=startBlock)return 0;
  const schedules=[...scheduleEntries]
    .filter(s=>Number.isFinite(Number(s?.block_num))&&Number(s?.block_num)<=endBlock)
    .sort((a,b)=>Number(a.block_num)-Number(b.block_num));
  if(!schedules.length)return 0;

  let expected=0;
  for(let i=0;i<schedules.length;i++){
    const cur=schedules[i];
    const curStart=Number(cur.block_num);
    const nextStart=i+1<schedules.length?Number(schedules[i+1].block_num):endBlock;
    const from=Math.max(startBlock,curStart);
    const to=Math.min(endBlock,nextStart);
    if(to<=from)continue;

    const producers=scheduleProducerNames(cur);
    const idx=producers.indexOf(name);
    if(idx<0)continue;

    // A schedule round contains 126 block slots: 21 producers x 6 blocks.
    // The first producer owns offsets 0..5, the second 6..11, etc.
    // Count the exact overlap with [from,to) without double-counting full
    // rounds and partial rounds.
    const offsetStart=from-curStart;
    const offsetEnd=to-curStart;
    const firstRound=Math.floor(offsetStart/126);
    const lastRound=Math.floor((offsetEnd-1)/126);
    const producerStart=idx*6;
    const producerEnd=producerStart+6;

    if(firstRound===lastRound){
      const a=offsetStart-firstRound*126;
      const b=offsetEnd-firstRound*126;
      expected+=Math.max(0,Math.min(b,producerEnd)-Math.max(a,producerStart));
      continue;
    }

    const firstA=offsetStart-firstRound*126;
    expected+=Math.max(0,Math.min(126,producerEnd)-Math.max(firstA,producerStart));

    const fullRounds=Math.max(0,lastRound-firstRound-1);
    expected+=fullRounds*6;

    const lastA=offsetEnd-lastRound*126;
    expected+=Math.max(0,Math.min(lastA,producerEnd)-producerStart);
  }
  return Math.max(0,Math.round(expected));
}

async function loadHistoricalSchedules(after,before,startVersion=null,endVersion=null,startBlock=0){
  const merged=new Map();

  function addItem(item){
    const version=Number(item?.version);
    const blockNum=Number(item?.block_num);
    const producers=Array.isArray(item?.producers)?item.producers:[];
    if(!Number.isFinite(version)||!Number.isFinite(blockNum)||!producers.length)return;
    const key=String(version);
    if(!merged.has(key)||blockNum<(Number(merged.get(key)?.block_num)||Infinity)){
      merged.set(key,item);
    }
  }

  function collectData(data){
    const items=[];
    if(Array.isArray(data?.schedules))items.push(...data.schedules);
    else if(Array.isArray(data?.schedule))items.push(...data.schedule);
    else if(Array.isArray(data))items.push(...data);
    else if(data?.schedule&&typeof data.schedule==='object')items.push(data.schedule);
    else if(Array.isArray(data?.results))items.push(...data.results);
    else if(data&&Number.isFinite(Number(data?.block_num))&&Array.isArray(data?.producers))items.push(data);
    items.forEach(addItem);
  }

  // Deterministic path: get the exact schedule versions recorded in the
  // boundary blocks, then ask Hyperion for those versions. This does not infer
  // schedule order from votes or from produced blocks.
  const versions=[];
  if(Number.isFinite(Number(startVersion)))versions.push(Number(startVersion));
  if(Number.isFinite(Number(endVersion))&&Number(endVersion)!==Number(startVersion))versions.push(Number(endVersion));

  if(versions.length){
    await Promise.all(versions.map(async version=>{
      try{
        const responses=await hyperionAllEndpoints('/v2/history/get_schedule?version='+encodeURIComponent(version));
        responses.forEach(({data})=>collectData(data));
      }catch(error){
        console.warn('Exact schedule-version lookup failed:',version,error);
      }
    }));
  }

  // Fetch every schedule activation returned for the selected block range.
  // `after`/`before` are Hyperion history parameters; no undocumented `mode`
  // flag is used here.
  try{
    const query=new URLSearchParams({after,before,limit:'1000'});
    const responses=await hyperionAllEndpoints('/v2/history/get_schedule?'+query.toString());
    responses.forEach(({data})=>collectData(data));
  }catch(error){
    console.warn('Historical schedule-range lookup failed:',error);
  }

  // Always fetch the schedule immediately before the first block as the
  // baseline. This is essential when no schedule change occurred during the
  // selected timeframe.
  if(startBlock>0){
    try{
      const query=new URLSearchParams({before:String(startBlock),limit:'1'});
      const responses=await hyperionAllEndpoints('/v2/history/get_schedule?'+query.toString());
      responses.forEach(({data})=>collectData(data));
    }catch(error){
      console.warn('Pre-range schedule lookup failed:',error);
    }
  }

  return [...merged.values()].sort((a,b)=>Number(a.block_num)-Number(b.block_num));
}


function parseMissedBlockCount(data, producer){
  // XPR Hyperion's get_missed_blocks response contains both aggregate stats
  // and individual missed-block events. The event `size` is the number of
  // consecutive blocks missed by that producer, so sum event sizes rather
  // than counting events.
  const events=Array.isArray(data?.events)?data.events:[];
  const ownEvents=events.filter(e=>String(e?.producer||'').trim()===producer);
  if(ownEvents.length){
    const sizes=ownEvents.map(e=>Number(e?.size)).filter(Number.isFinite);
    if(sizes.length)return sizes.reduce((sum,n)=>sum+Math.max(0,Math.round(n)),0);
  }

  const byProducer=data?.stats?.by_producer;
  if(byProducer && typeof byProducer==='object'){
    const candidates=[
      byProducer[producer],
      ...(Array.isArray(byProducer)?byProducer.filter(x=>String(x?.producer||x?.name||'')===producer):[])
    ].filter(Boolean);
    for(const item of candidates){
      for(const key of ['missed_blocks','missed','blocks','count','value','total']){
        const n=Number(item?.[key] ?? (typeof item==='number'?item:NaN));
        if(Number.isFinite(n))return Math.max(0,Math.round(n));
      }
    }
  }

  // Some XPR Hyperion versions expose the producer's aggregate directly as
  // `total`, instead of returning the individual events/by_producer object.
  // Keep this fallback because that was the response shape used successfully
  // by the earlier working version of the dashboard.
  const totalCandidates=[
    data?.total?.value,
    data?.total,
    data?.stats?.total,
    data?.missed_blocks,
    data?.missed,
    data?.count,
    data?.value
  ];
  for(const value of totalCandidates){
    const n=Number(value);
    if(Number.isFinite(n))return Math.max(0,Math.round(n));
  }
  return 0;
}


