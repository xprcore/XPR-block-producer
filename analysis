/* =========================================================
STAKER VOTING MODAL
========================================================= */
.staker-clickable{
  cursor:pointer;
  transition:transform .15s ease, opacity .15s ease;
}
.staker-clickable:hover{opacity:.86;transform:translateY(-1px);}
.staker-clickable:focus-visible{outline:2px solid rgba(90,169,248,.8);outline-offset:2px;border-radius:8px;}
/* =========================================================
SHORT / LONG STAKE ANALYTICS
========================================================= */

.staking-analytics-panel{
margin-top:16px;
}

.staking-analytics-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:10px;
margin-top:14px;
}

.staking-window-card{
padding:14px;
border-radius:13px;
background:rgba(2,17,36,.52);
border:1px solid rgba(90,169,248,.13);
min-width:0;
}

.staking-window-title{
font-size:13px;
font-weight:bold;
margin-bottom:11px;
}

.staking-window-row{
display:flex;
justify-content:space-between;
align-items:center;
gap:10px;
padding:7px 0;
border-bottom:1px solid rgba(91,169,248,.09);
font-size:10px;
}

.staking-window-row:last-child{border-bottom:0;}

.staking-window-row span{color:var(--muted);}

.staking-window-row strong{
color:white;
text-align:right;
word-break:break-word;
}

.staking-window-user{
margin-top:10px;
padding:9px;
border-radius:8px;
background:rgba(90,169,248,.05);
border:1px solid rgba(90,169,248,.08);
}

.staking-window-user-label{
font-size:8px;
color:var(--muted);
text-transform:uppercase;
letter-spacing:.08em;
}

.staking-window-user-value{
font-size:11px;
font-weight:bold;
margin-top:4px;
word-break:break-all;
}

.staking-analytics-loading{
padding:15px;
text-align:center;
color:var(--muted);
font-size:11px;
}

