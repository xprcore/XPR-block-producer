let remoteNetworkHistoryLoaded=false;
async function loadRemoteNetworkHistory(){
  if(remoteNetworkHistoryLoaded)return;
  remoteNetworkHistoryLoaded=true;
  try{
    const response=await fetch("../data/network-history.json?ts="+Date.now(),{cache:"no-store",headers:{"Accept":"application/json"}});
    if(!response.ok)throw new Error("network-history.json HTTP "+response.status);
    const payload=await response.json();
    const remote=Array.isArray(payload?.points)?payload.points:[];
    const cutoff=Date.now()-NETWORK_HISTORY_MAX_MS;
    const merged=new Map();
    for(const point of networkHistory){
      if(Number(point?.ts)>=cutoff)merged.set(String(point?.block||point?.ts),point);
    }
    for(const point of remote){
      if(Number(point?.ts)>=cutoff)merged.set(String(point?.block||point?.ts),point);
    }
    networkHistory=[...merged.values()].sort((a,b)=>Number(a.ts)-Number(b.ts));
    try{localStorage.setItem(NETWORK_HISTORY_KEY,JSON.stringify(networkHistory));}catch(e){}
    drawNetworkCharts();
  }catch(error){
    console.warn("Central network history unavailable:",error);
  }
}

