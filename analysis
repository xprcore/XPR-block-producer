/*
  Metal X exposes the XPR/XMD market through its public DEX API.
  XMD is designed as a USD-oriented stablecoin, so it is used here
  as the USD valuation reference for the account summary.
*/
const METALX_PRICE_ENDPOINTS=[
  "https://dex.api.mainnet.metalx.com/dex/v1/trades/daily?symbol=XPR_XMD",
  "https://dex.api.mainnet.metalx.com/dex/v1/orders/depth?symbol=XPR_XMD&step=1000&limit=20"
];

function numberFromAny(value){
  if(value===undefined||value===null)return null;

  if(typeof value==="number"){
    return Number.isFinite(value)?value:null;
  }

  const n=Number(
    String(value)
      .replace(/,/g,"")
      .replace(/[^\d.eE+-]/g,"")
  );

  return Number.isFinite(n)?n:null;
}

function findPriceInObject(value,depth=0){
  if(depth>5||value===null||value===undefined)return null;

  if(Array.isArray(value)){
    for(const item of value){
      const found=findPriceInObject(item,depth+1);
      if(found!==null&&found>0&&found<1000){
        return found;
      }
    }
    return null;
  }

  if(typeof value!=="object"){
    return null;
  }

  const preferredKeys=[
    "last_price",
    "lastPrice",
    "price",
    "close",
    "last",
    "mid_price",
    "midPrice",
    "rate"
  ];

  for(const key of preferredKeys){
    if(Object.prototype.hasOwnProperty.call(value,key)){
      const n=numberFromAny(value[key]);
      if(n!==null&&n>0&&n<1000){
        return n;
      }
    }
  }

  for(const key of Object.keys(value)){
    const found=findPriceInObject(value[key],depth+1);
    if(found!==null&&found>0&&found<1000){
      return found;
    }
  }

  return null;
}

let xprPriceInFlight=null;

async function getXPRPriceUSD(){
  if(Number.isFinite(currentXPRPriceUSD)&&currentXPRPriceUSD>0){
    return currentXPRPriceUSD;
  }
  if(xprPriceInFlight)return xprPriceInFlight;

  xprPriceInFlight=(async()=>{
  for(const endpoint of METALX_PRICE_ENDPOINTS){
    try{
      const response=await fetch(endpoint,{
        method:"GET",
        headers:{
          "Accept":"application/json"
        },
        cache:"no-store"
      });

      if(!response.ok)continue;

      const data=await response.json();
      const price=findPriceInObject(data);

      if(price!==null&&price>0){
        currentXPRPriceUSD=price;
        return price;
      }
    }catch(error){
      console.warn("XPR price lookup failed:",error);
    }
  }

  return null;
  })().finally(()=>{xprPriceInFlight=null;});
  return xprPriceInFlight;
}

function accountAssetNumber(value){
  if(value===undefined||value===null)return 0;

  const text=String(value).trim();
  const match=text.replace(/,/g,"").match(/-?\d+(?:\.\d+)?/);

  if(!match)return 0;

  const n=Number(match[0]);
  return Number.isFinite(n)?n:0;
}

function accountStakeNumber(value){
  /*
    XPR votersxpr data is stored in raw 1/10000 XPR units.
    If a value is already an asset string, this also handles it.
  */
  if(value===undefined||value===null||value==="")return 0;

  const text=String(value).trim();

  if(/[A-Za-z]/.test(text)){
    return accountAssetNumber(text);
  }

  const n=Number(String(value).replace(/,/g,""));

  if(!Number.isFinite(n))return 0;

  /*
    Raw chain values are normally >= 10000 for 1 XPR.
    Small decimal values are treated as already-human XPR.
  */
  return Math.abs(n)>=10000?n/10000:n;
}

function formatAccountXPR(value){
  const n=Number(value);

  if(!Number.isFinite(n))return "—";

  return new Intl.NumberFormat("en-US",{
    minimumFractionDigits:0,
    maximumFractionDigits:4
  }).format(n)+" XPR";
}

function formatAccountUSD(value){
  const n=Number(value);

  if(!Number.isFinite(n))return "—";

  return new Intl.NumberFormat("en-US",{
    style:"currency",
    currency:"USD",
    maximumFractionDigits:2
  }).format(n);
}

