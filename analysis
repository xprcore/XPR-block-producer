function normalizeHistoryAction(action){

if(!action||typeof action!=="object")return null;

const data=
action.act?.data||
action.action_trace?.act?.data||
action.data||
{};

const actionName=String(
action.act?.name||
action.action_trace?.act?.name||
action.action?.name||
action.action||
action.name||
""
).toLowerCase();

if(actionName!=="stakexpr")return null;

let account=
data.from||
data.owner||
data.account||
data.receiver||
"";

if(!account&&Array.isArray(action.act?.authorization)){
account=action.act.authorization[0]?.actor||"";
}

if(!account&&Array.isArray(action.action_trace?.act?.authorization)){
account=action.action_trace.act.authorization[0]?.actor||"";
}

const quantity=
data.stake_xpr_quantity||
data.quantity||
data.amount||
data.staked||
"";

let amount=stakingAmount(quantity);

if(!amount&&typeof quantity==="number")amount=quantity/10000;

const timestamp=
action["@timestamp"]||
action.timestamp||
action.block_time||
action.created_at||
action.action_trace?.block_time||
null;

const blockNum=
action.block_num||
action.block||
action.block_number||
action.action_trace?.block_num||
null;

const trxId=
action.trx_id||
action.transaction_id||
action.id||
action.action_trace?.trx_id||
"";

return{
account,
amount,
timestamp,
blockNum,
trxId,
raw:action
};

}

