async function getAllVoterRowsFromTable(tableName){

const allRows=[];
let lowerBound=null;
let page=0;
const maxPages=100;

while(page<maxPages){

const params={
json:true,
code:"eosio",
scope:"eosio",
table:tableName,
limit:1000
};

if(
lowerBound!==null &&
lowerBound!==undefined &&
lowerBound!==""
){

params.lower_bound=lowerBound;

}

const result=await rpcRequest(
"/v1/chain/get_table_rows",
params
);

if(Array.isArray(result.rows)){
allRows.push(...result.rows);
}

if(
!result.more ||
!result.next_key
){
break;
}

let nextKey=result.next_key;

if(typeof nextKey==="object"){

if(Array.isArray(nextKey)){

nextKey=nextKey[0];

}else{

nextKey=
nextKey.owner||
nextKey.voter||
nextKey.account||
nextKey.name||
Object.values(nextKey)[0];

}

}

if(
nextKey===undefined||
nextKey===null||
String(nextKey)===String(lowerBound)
){

break;

}

lowerBound=nextKey;
page++;

}

return allRows;

}

