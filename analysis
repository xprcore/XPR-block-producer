async function hyperionAllEndpoints(path){
  const results=[];
  await Promise.all(HYPERION_ENDPOINTS.map(async endpoint=>{
    try{
      const controller=new AbortController();
      const timeout=setTimeout(()=>controller.abort(),12000);
