function producerIsInVoteList(
row,
producerAccount
){

const possibleLists=[
row.producers,
row.producer_votes,
row.voted_producers,
row.votes_for,
row.votes
];

for(const list of possibleLists){

if(!Array.isArray(list))continue;

for(const item of list){

if(typeof item==="string"){

if(item===producerAccount){
return true;
}

continue;

}

if(item&&typeof item==="object"){

const possibleProducer=
item.producer||
item.owner||
item.name||
item.account;

if(possibleProducer===producerAccount){
return true;
}

}

}

}

return false;

}

